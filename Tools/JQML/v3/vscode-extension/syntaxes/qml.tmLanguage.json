{
    "name": "JQML",
    "scopeName": "source.jqml",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#import" },
        { "include": "#pragma" },
        { "include": "#function-def" },
        { "include": "#property-def" },
        { "include": "#signal-def" },
        { "include": "#script-block" },
        { "include": "#keywords" },
        { "include": "#id" },
        { "include": "#element" },
        { "include": "#binding" },
        { "include": "#numbers" },
        { "include": "#constants" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.jqml",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.jqml",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.jqml",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.jqml", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.jqml",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        { "name": "constant.character.escape.jqml", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.other.jqml",
                    "begin": "`",
                    "end": "`",
                    "patterns": [
                        { "name": "constant.character.escape.jqml", "match": "\\\\." }
                    ]
                }
            ]
        },
        "import": {
            "name": "meta.import.jqml",
            "match": "^\\s*(import)\\s+([A-Za-z_][\\w.]*)(?:\\s+(\\d+(?:\\.\\d+)?))?(?:\\s+(as)\\s+([A-Za-z_]\\w*))?",
            "captures": {
                "1": { "name": "keyword.control.import.jqml" },
                "2": { "name": "entity.name.namespace.jqml" },
                "3": { "name": "constant.numeric.jqml" },
                "4": { "name": "keyword.control.as.jqml" },
                "5": { "name": "variable.other.alias.jqml" }
            }
        },
        "pragma": {
            "match": "^\\s*(pragma)\\s+([A-Za-z_]\\w*)",
            "captures": {
                "1": { "name": "keyword.control.pragma.jqml" },
                "2": { "name": "support.constant.pragma.jqml" }
            }
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.jqml",
                    "match": "\\b(readonly|required|default|property|signal|alias|enum|as|function|id)\\b"
                },
                {
                    "name": "keyword.control.jqml",
                    "match": "\\b(if|else|for|while|do|switch|case|break|continue|return|try|catch|finally|throw|new|in|of|typeof|instanceof|delete|var|let|const)\\b"
                }
            ]
        },
        "property-def": {
            "match": "\\b((?:readonly|required|default)\\s+)*(property)\\s+([A-Za-z_][\\w.]*(?:\\s*<\\s*[A-Za-z_]\\w*\\s*>)?)\\s+([A-Za-z_]\\w*)",
            "captures": {
                "1": { "name": "storage.modifier.jqml" },
                "2": { "name": "keyword.control.jqml" },
                "3": { "name": "storage.type.jqml" },
                "4": { "name": "variable.other.property.jqml" }
            }
        },
        "signal-def": {
            "match": "\\b(signal)\\s+([A-Za-z_]\\w*)",
            "captures": {
                "1": { "name": "keyword.control.jqml" },
                "2": { "name": "entity.name.function.signal.jqml" }
            }
        },
        "function-def": {
            "match": "\\b(function)\\s+([A-Za-z_]\\w*)",
            "captures": {
                "1": { "name": "keyword.control.jqml" },
                "2": { "name": "entity.name.function.jqml" }
            }
        },
        "id": {
            "match": "\\b(id)\\s*:\\s*([A-Za-z_]\\w*)",
            "captures": {
                "1": { "name": "keyword.control.jqml" },
                "2": { "name": "entity.name.tag.id.jqml" }
            }
        },
        "element": {
            "match": "\\b([A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*)\\b(?=\\s*(?:on\\s+[A-Za-z_]\\w*)?\\s*\\{)",
            "name": "support.class.qmltype.jqml"
        },
        "code": {
            "patterns": [
                { "include": "#comments" },
                { "include": "#strings" },
                { "include": "#js-braces" },
                { "include": "#function-def" },
                { "include": "#keywords" },
                { "include": "#numbers" },
                { "include": "#constants" }
            ]
        },
        "js-braces": {
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                { "include": "#code" }
            ]
        },
        "script-block": {
            "begin": "(?<![A-Za-z0-9_])([A-Za-z_][\\w.]*)\\s*(:)[ \\t]*(?:\\r?\\n[ \\t]*)?(\\{)",
            "beginCaptures": {
                "1": { "name": "variable.other.property.jqml" },
                "2": { "name": "keyword.operator.assignment.jqml" },
                "3": { "name": "punctuation.section.block.begin.jqml" }
            },
            "end": "\\}",
            "endCaptures": {
                "0": { "name": "punctuation.section.block.end.jqml" }
            },
            "patterns": [
                { "include": "#code" }
            ]
        },
        "binding": {
            "begin": "(?<![A-Za-z0-9_])([A-Za-z_][\\w.]*)\\s*(:)",
            "beginCaptures": {
                "1": { "name": "variable.other.property.jqml" },
                "2": { "name": "keyword.operator.assignment.jqml" }
            },
            "end": "(?=[\\r\\n;])|(?=\\s*[A-Za-z_][\\w.]*\\s*:)|(?=\\s*[A-Z][\\w.]*\\s*\\{)|(?=\\s*\\})",
            "patterns": [
                { "include": "#code" }
            ]
        },
        "numbers": {
            "name": "constant.numeric.jqml",
            "match": "\\b(?:0x[0-9A-Fa-f]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b"
        },
        "constants": {
            "name": "constant.language.jqml",
            "match": "\\b(true|false|null|undefined)\\b"
        }
    }
}
