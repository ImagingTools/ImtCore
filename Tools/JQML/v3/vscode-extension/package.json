{
    "name": "jqml",
    "displayName": "JQML",
    "description": "Syntax highlighting, completions and diagnostics for the JQML engine",
    "version": "1.0.21",
    "publisher": "imtcore",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:jqml",
        "onDebug:jqml"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "jqml",
                "aliases": [
                    "JQML",
                    "QML"
                ],
                "extensions": [
                    ".qml"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "jqml",
                "scopeName": "source.jqml",
                "path": "./syntaxes/qml.tmLanguage.json"
            }
        ],
        "breakpoints": [
            { "language": "jqml" },
            { "language": "qml" }
        ],
        "debuggers": [
            {
                "type": "jqml",
                "label": "JQML",
                "languages": ["jqml", "qml"],
                "program": "./src/debugAdapter.js",
                "runtime": "node",
                "configurationAttributes": {
                    "launch": {
                        "required": [],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "QML file to open with breakpoints.",
                                "default": "${file}"
                            }
                        }
                    }
                },
                "configurationSnippets": [
                    {
                        "label": "JQML: breakpoints",
                        "description": "Set breakpoints in a QML file.",
                        "body": {
                            "type": "jqml",
                            "request": "launch",
                            "name": "JQML",
                            "program": "^\"\\${file}\""
                        }
                    }
                ]
            }
        ],
        "configuration": {
            "title": "JQML",
            "properties": {
                "jqml.enginePath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional path to a JQML v3 engine root. Leave empty to use the types bundled in the extension."
                },
                "jqml.configPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to a JQML compiler JSON config with dirs/includes. Absolute path, ${workspaceFolder}, and ${env:NAME} are supported. Placeholders inside the config are taken from jqml.env and the process environment."
                },
                "jqml.env": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "default": {},
                    "description": "Environment variables used when resolving ${NAME} placeholders in jqml.configPath and in the compiler config. These values override the process environment."
                },
                "jqml.hideInternalMembers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Hide engine-internal members such as JQ* and AX/AY from completions."
                }
            }
        }
    }
}
