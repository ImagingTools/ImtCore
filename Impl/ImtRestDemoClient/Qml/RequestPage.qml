import QtQuick
import QtQuick.Controls
import QtQuick.Layouts


// The request that is sent with the HTTP client library: the method, the path, the headers and the body of any size
// (a text, a file or generated bytes, also in chunks)
Item {
	id: root

	readonly property string monoFont: Qt.platform.os === "osx" ? "Menlo" : (Qt.platform.os === "windows" ? "Consolas" : "DejaVu Sans Mono")

	// Size with a suffix: 10K, 5M, 2G
	function parseSize(text) {
		var match = /^\s*(\d+(?:\.\d+)?)\s*([kKmMgG]?)[iI]?[bB]?\s*$/.exec(text)
		if (!match)
			return -1

		var factor = {"": 1, "k": 1024, "m": 1024 * 1024, "g": 1024 * 1024 * 1024}[match[2].toLowerCase()]

		return Math.round(Number(match[1]) * factor)
	}

	function load(preset) {
		var options = preset.options
		methodBox.currentIndex = Math.max(0, methodBox.model.indexOf(options.method || "GET"))
		pathField.text = options.path || "/"
		headersArea.text = options.headers || ""
		tokenCheck.checked = options.useToken === true
		expectCheck.checked = options.expectContinue === true
		redirectCheck.checked = options.followRedirects === true
		bodyTypeBox.currentIndex = Math.max(0, bodyTypeBox.model.indexOf(options.bodyType || "none"))
		bodyTextArea.text = options.bodyText || ""
		bodyFileField.text = options.bodyFile || ""
		bodySizeField.text = options.bodySize !== undefined ? String(options.bodySize) : "1M"
		bodyOffsetField.text = options.bodyOffset !== undefined ? String(options.bodyOffset) : "0"
		chunkedCheck.checked = options.isChunked === true
		resumableCheck.checked = options.contentRange === true
		breakField.text = options.abortAfter ? String(options.abortAfter) : ""
		saveField.text = options.saveTo || ""
		patternCheck.checked = options.checkPattern === true
		patternOffsetField.text = options.patternOffset !== undefined ? String(options.patternOffset) : "0"
		noteLabel.text = preset.description || ""
	}

	function getOptions() {
		return {
			"method": methodBox.currentText,
			"path": pathField.text,
			"headers": headersArea.text,
			"useToken": tokenCheck.checked,
			"expectContinue": expectCheck.checked,
			"followRedirects": redirectCheck.checked,
			"bodyType": bodyTypeBox.currentText,
			"bodyText": bodyTextArea.text,
			"bodyFile": bodyFileField.text,
			"bodySize": parseSize(bodySizeField.text),
			"bodyOffset": parseSize(bodyOffsetField.text),
			"isChunked": chunkedCheck.checked,
			"contentRange": resumableCheck.checked && (bodyTypeBox.currentText === "file" || bodyTypeBox.currentText === "generated"),
			"rangeStart": 0,
			"abortAfter": breakField.text.trim() === "" ? 0 : Math.max(0, parseSize(breakField.text)),
			"saveTo": saveField.text,
			"checkPattern": patternCheck.checked,
			"patternOffset": parseSize(patternOffsetField.text)
		}
	}

	function send() {
		client.sendRequest(getOptions())
	}

	function resume() {
		client.resumeUpload(getOptions())
	}

	TextEdit {
		id: clipboardHelper

		visible: false
	}

	RowLayout {
		anchors.fill: parent
		anchors.margins: 10
		spacing: 14

		ColumnLayout {
			Layout.fillWidth: true
			Layout.fillHeight: true
			Layout.preferredWidth: 1

			RowLayout {
				Layout.fillWidth: true

				ComboBox {
					id: methodBox

					model: ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
				}

				TextField {
					id: pathField

					Layout.fillWidth: true
					text: "/echo?x=1"
					placeholderText: "/path?query"
					selectByMouse: true

					onAccepted: root.send()
				}

				Button {
					text: qsTr("Send")
					highlighted: true

					onClicked: root.send()
				}
			}

			Label {
				text: qsTr("Headers (one line: Name: value)")
			}

			ScrollView {
				Layout.fillWidth: true
				Layout.preferredHeight: 90

				TextArea {
					id: headersArea

					font.family: root.monoFont
					placeholderText: "X-Debug: preview"
					selectByMouse: true
					background: Rectangle {
						border.color: "#b0b0b0"
					}
				}
			}

			Label {
				id: noteLabel

				Layout.fillWidth: true
				wrapMode: Text.WordWrap
				color: "#555555"
			}

			Item {
				Layout.fillHeight: true
			}
		}

		ColumnLayout {
			Layout.fillWidth: true
			Layout.fillHeight: true
			Layout.preferredWidth: 1

			RowLayout {
				Label {
					text: qsTr("Body")
				}

				ComboBox {
					id: bodyTypeBox

					model: ["none", "text", "file", "generated"]
				}

				CheckBox {
					id: chunkedCheck

					text: qsTr("in chunks")
					visible: bodyTypeBox.currentText === "generated"
					ToolTip.visible: hovered
					ToolTip.text: "Transfer-Encoding: chunked. The chunks are written to the socket by the client itself: a client library does not send them."
				}
			}

			StackLayout {
				Layout.fillWidth: true
				Layout.preferredHeight: 70
				currentIndex: bodyTypeBox.currentIndex

				Item {
				}

				ScrollView {
					TextArea {
						id: bodyTextArea

						font.family: root.monoFont
						placeholderText: qsTr("Text of the body")
						selectByMouse: true
						background: Rectangle {
							border.color: "#b0b0b0"
						}
					}
				}

				TextField {
					id: bodyFileField

					placeholderText: qsTr("Path of the file to send")
					selectByMouse: true
				}

				RowLayout {
					Label {
						text: qsTr("Size")
					}

					TextField {
						id: bodySizeField

						Layout.preferredWidth: 110
						text: "1M"
						selectByMouse: true
						ToolTip.visible: hovered
						ToolTip.text: qsTr("Bytes, or with the suffix K, M, G (1024). The bytes are generated while they are sent.")
					}

					Label {
						text: qsTr("from the position")
					}

					TextField {
						id: bodyOffsetField

						Layout.preferredWidth: 90
						text: "0"
						selectByMouse: true
					}

					Item {
						Layout.fillWidth: true
					}
				}
			}

			RowLayout {
				visible: bodyTypeBox.currentText === "file" || bodyTypeBox.currentText === "generated"

				CheckBox {
					id: resumableCheck

					text: qsTr("Resumable")
					ToolTip.visible: hovered
					ToolTip.text: "Content-Range: bytes 0-<last>/<size>. The server keeps the bytes that it has received if the connection is broken."
				}

				Label {
					text: qsTr("break after")
				}

				TextField {
					id: breakField

					Layout.preferredWidth: 90
					placeholderText: qsTr("(no)")
					selectByMouse: true
					ToolTip.visible: hovered
					ToolTip.text: qsTr("The client stops the upload after this number of bytes (K, M, G): the connection is broken. Choose a value that is much less than the size of the body.")
				}

				Button {
					text: qsTr("Resume")
					ToolTip.visible: hovered
					ToolTip.text: qsTr("Ask the server how much of the file it has, and send only the rest with Content-Range")
					onClicked: root.resume()
				}

				Item {
					Layout.fillWidth: true
				}
			}

			RowLayout {
				CheckBox {
					id: tokenCheck

					text: qsTr("Token")
					ToolTip.visible: hovered
					ToolTip.text: "Authorization: Bearer <token of the toolbar>"
				}

				CheckBox {
					id: expectCheck

					text: "Expect: 100-continue"
				}

				CheckBox {
					id: redirectCheck

					text: qsTr("Follow redirects")
				}
			}

			RowLayout {
				Layout.fillWidth: true

				Label {
					text: qsTr("Save the response to")
				}

				TextField {
					id: saveField

					Layout.fillWidth: true
					placeholderText: qsTr("(the body is only counted and checked)")
					selectByMouse: true
				}
			}

			RowLayout {
				CheckBox {
					id: patternCheck

					text: qsTr("Check the body as the pattern of the demo server, from")
				}

				TextField {
					id: patternOffsetField

					Layout.preferredWidth: 90
					text: "0"
					enabled: patternCheck.checked
					selectByMouse: true
				}
			}

			RowLayout {
				Button {
					text: qsTr("Copy as curl")
					onClicked: {
						clipboardHelper.text = client.makeCurlCommand(root.getOptions())
						clipboardHelper.selectAll()
						clipboardHelper.copy()
						noteLabel.text = qsTr("Copied: %1").arg(clipboardHelper.text)
					}
				}

				Item {
					Layout.fillWidth: true
				}
			}

			Item {
				Layout.fillHeight: true
			}
		}
	}
}
