        <Element Id="AssistantProvider" PackageId="ImtAssistPck" ComponentId="FakeAssistantProvider">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="Configured" Type="Boolean" ExportId="">
                        <Data IsEnabled="true" Value="true"/>
                    </AttributeInfo>
                    <AttributeInfo Id="DefaultReply" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value="I can show tasks and change their status. Try &quot;Show open tasks&quot;."/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="RuleActionIds" Type="Id[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>tasks.setStatus</Value>
                                <Value>tasks.search</Value>
                                <Value>tasks.search</Value>
                                <Value>tasks.setStatus</Value>
                                <Value>tasks.setStatus</Value>
                                <Value></Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="RuleKeywords" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>reopen</Value>
                                <Value>open tasks</Value>
                                <Value>show</Value>
                                <Value>done</Value>
                                <Value>progress</Value>
                                <Value>help</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="RuleParameters" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>{"taskId": "$context.selection.id", "status": "open"}</Value>
                                <Value>{"status": "open"}</Value>
                                <Value>{}</Value>
                                <Value>{"taskId": "$context.selection.id", "status": "done"}</Value>
                                <Value>{"taskId": "$context.selection.id", "status": "inProgress"}</Value>
                                <Value></Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="RuleQuestions" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>Which task do you mean? Select it in the list and hand it over.</Value>
                                <Value></Value>
                                <Value></Value>
                                <Value>Which task do you mean? Select it in the list and hand it over.</Value>
                                <Value>Which task do you mean? Select it in the list and hand it over.</Value>
                                <Value></Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="RuleReplies" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value></Value>
                                <Value></Value>
                                <Value></Value>
                                <Value></Value>
                                <Value></Value>
                                <Value>Ask me to "Show open tasks", select a task, hand it over and say "Mark it as done".</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ToolResultReply" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value="Select a task in the list, hand it over and tell me what to do, e.g. &quot;Mark it as done&quot;."/>
                    </AttributeInfo>
                    <AttributeInfo Id="TracingConfiguration" Type="Reference" ExportId="TracingConfiguration">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
