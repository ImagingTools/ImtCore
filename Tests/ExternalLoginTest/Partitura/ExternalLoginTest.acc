                    </AttributeInfo>
                    <AttributeInfo Id="ProviderId" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="testidp"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ProviderName" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value="Test IdP"/>
                    </AttributeInfo>
                    <AttributeInfo Id="TokenEndpoint" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="http://127.0.0.1:18931/token"/>
                    </AttributeInfo>
                    <AttributeInfo Id="UserInfoEndpoint" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="http://127.0.0.1:18931/userinfo"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="SettingsAuthorizationEndpointParam" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value=" https://idp.example.org/authorize "/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="SettingsClientIdParam" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value="settings-client"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="SettingsEmptyParam" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
