                        <Data IsEnabled="true" Value="Company Login"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="SettingsProvider" PackageId="ImtAuthPck" ComponentId="GenericOidcProvider">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="AuthorizationEndpoint" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="https://attribute.example.org/authorize"/>
                    </AttributeInfo>
                    <AttributeInfo Id="AuthorizationEndpointParam" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="SettingsAuthorizationEndpointParam"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ClientId" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="attribute-client"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ClientIdParam" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="SettingsClientIdParam"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ClientSecret" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="attribute-secret"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ClientSecretParam" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="SettingsEmptyParam"/>
                    </AttributeInfo>
                    <AttributeInfo Id="IssuerParam" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="SettingsIssuerParam"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Issuers" Type="String[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>https://attribute.example.org</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ProviderNameParam" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="SettingsNameParam"/>
                    </AttributeInfo>
                    <AttributeInfo Id="TokenEndpoint" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="https://attribute.example.org/token"/>
                    </AttributeInfo>
                    <AttributeInfo Id="TokenEndpointParam" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="SettingsEmptyParam"/>
                    </AttributeInfo>
                </AttributeInfoMap>
