<?xml version="1.0" encoding="UTF-8"?>
<Acf>
    <AcfHeader>
        <VersionInfos>
            <Version Id="0" Number="6390" Description="ACF"/>
            <Version Id="1" Number="2306" Description="ACF-Solutions"/>
            <Version Id="1023" Number="395264" Description="Qt Framework"/>
        </VersionInfos>
    </AcfHeader>
    <Description>External Login Test Configuration</Description>
    <Keywords>Test OIDC ExternalLogin</Keywords>
    <ElementsList>
        <Element Id="ExternalIdentity" PackageId="ImtAuthPck" ComponentId="ExternalIdentity">
            <Data IsEnabled="true" Flags="2">
                <AttributeInfoMap/>
            </Data>
        </Element>
        <Element Id="ExternalIdentityManager" PackageId="ImtAuthPck" ComponentId="ExternalIdentityManager">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="IdentityCollection" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="IdentityCollection"/>
                    </AttributeInfo>
                    <AttributeInfo Id="IdentityFactory" Type="Factory" ExportId="">
                        <Data IsEnabled="true" Value="ExternalIdentity"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ExternalLoginController" PackageId="ImtAuthPck" ComponentId="ExternalLoginController">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="CallbackUrl" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="https://app.example.com/ExternalLogin/Callback"/>
                    </AttributeInfo>
                    <AttributeInfo Id="IdentityManager" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="ExternalIdentityManager"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Providers" Type="Reference[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>TestProvider</Value>
                                <Value>UnconfiguredGoogleProvider</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="RequestTimeout" Type="Integer" ExportId="">
                        <Data IsEnabled="true" Value="5000"/>
                    </AttributeInfo>
                    <AttributeInfo Id="UserCollection" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="UserCollection"/>
                    </AttributeInfo>
                    <AttributeInfo Id="UserFactory" Type="Factory" ExportId="">
                        <Data IsEnabled="true" Value="UserInfo"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="RegisteringLoginController" PackageId="ImtAuthPck" ComponentId="ExternalLoginController">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="AllowRegistration" Type="Boolean" ExportId="">
                        <Data IsEnabled="true" Value="true"/>
                    </AttributeInfo>
                    <AttributeInfo Id="CallbackUrl" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="https://app.example.com/ExternalLogin/Callback"/>
                    </AttributeInfo>
                    <AttributeInfo Id="IdentityManager" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="ExternalIdentityManager"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Providers" Type="Reference[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>TestProvider</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="RequestTimeout" Type="Integer" ExportId="">
                        <Data IsEnabled="true" Value="5000"/>
                    </AttributeInfo>
                    <AttributeInfo Id="UserCollection" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="UserCollection"/>
                    </AttributeInfo>
                    <AttributeInfo Id="UserFactory" Type="Factory" ExportId="">
                        <Data IsEnabled="true" Value="UserInfo"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="IdentityCollection" PackageId="ImtCorePck" ComponentId="ObjectCollection">
            <Data IsEnabled="true" Flags="2">
                <AttributeInfoMap>
                    <AttributeInfo Id="ObjectFactories" Type="Factory[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>ExternalIdentity</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ObjectPersistenceList" Type="Reference[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>JsonSerializer</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="TypeIds" Type="Id[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
