                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="TypeNames" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>External Identity</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="JsonSerializer" PackageId="FilePck" ComponentId="JsonFileSerializer">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="VersionInfo" Type="Reference" ExportId="VersionInfo">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="TestProvider" PackageId="ImtAuthPck" ComponentId="GenericOidcProvider">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="AuthorizationEndpoint" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="http://127.0.0.1:18931/authorize"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ClientId" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="test-client"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ClientSecret" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="test-secret"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Issuers" Type="String[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
