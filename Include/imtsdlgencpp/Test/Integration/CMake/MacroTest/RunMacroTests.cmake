# Checks the SDL CMake macros ('ImtCoreCustomConfigureSdlCpp', 'ImtCoreCustomConfigureSdlCppQml').
#
# Usage: cmake -DIMTCOREDIR=<path> (-DQt6_DIR=<path> | -DQT_PREFIX_PATH=<Qt path>) [-DWORK_DIR=<path>] [-DTEST_GENERATOR=Ninja] -P RunMacroTests.cmake
#
# Every case is configured as a separate project (see 'CMakeLists.txt' in this directory).
# The positive cases are also checked by the generated build system: the command lines of the generator.

if(NOT DEFINED IMTCOREDIR)
	set(IMTCOREDIR "$ENV{IMTCOREDIR}")
endif()
if(NOT IMTCOREDIR)
	message(FATAL_ERROR "IMTCOREDIR is not set")
endif()
if(NOT DEFINED TEST_GENERATOR)
	set(TEST_GENERATOR "Ninja")
endif()
if(NOT DEFINED WORK_DIR)
	set(WORK_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../../../../../../build-sdl-macro-test")
endif()

set(QT_ARGS)
if(DEFINED Qt6_DIR)
	list(APPEND QT_ARGS -DQt6_DIR=${Qt6_DIR})
endif()
if(DEFINED QT_PREFIX_PATH)
	list(APPEND QT_ARGS -DCMAKE_PREFIX_PATH=${QT_PREFIX_PATH})
endif()

set(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(TEST_DATA_DIR "${IMTCOREDIR}/Include/imtsdlgencpp/Test/TestData")
set(FAILED_COUNT 0)


#! Configures a case. \param EXPECT_SUCCESS - TRUE, if the configuration should succeed. \param EXPECTED_MESSAGE - [optional] the text of the error
function(configure_case CASE_NAME EXPECT_SUCCESS EXPECTED_MESSAGE)
	set(CASE_BINARY_DIR "${WORK_DIR}/${CASE_NAME}")
	file(REMOVE_RECURSE "${CASE_BINARY_DIR}")

	execute_process(
		COMMAND ${CMAKE_COMMAND} -S "${SOURCE_DIR}" -B "${CASE_BINARY_DIR}" -G "${TEST_GENERATOR}"
			-DTEST_CASE=${CASE_NAME} -DIMTCOREDIR=${IMTCOREDIR} ${QT_ARGS}
		RESULT_VARIABLE RESULT
		OUTPUT_VARIABLE OUTPUT
		ERROR_VARIABLE ERROR_OUTPUT)

	# CMake wraps the long messages
	string(REGEX REPLACE "[ \t\r\n]+" " " ERROR_OUTPUT "${ERROR_OUTPUT}")

	set(CASE_ERROR "")
	if (EXPECT_SUCCESS AND NOT RESULT EQUAL 0)
		set(CASE_ERROR "the configuration failed, but it is expected to succeed: ${ERROR_OUTPUT}")
	elseif (NOT EXPECT_SUCCESS AND RESULT EQUAL 0)
		set(CASE_ERROR "the configuration succeeded, but it is expected to fail")
	elseif (NOT EXPECT_SUCCESS AND NOT "${ERROR_OUTPUT}" MATCHES "${EXPECTED_MESSAGE}")
		set(CASE_ERROR "the error doesn't contain '${EXPECTED_MESSAGE}': ${ERROR_OUTPUT}")
	endif()

	set(CASE_ERROR "${CASE_ERROR}" PARENT_SCOPE)
	set(CASE_BINARY_DIR "${CASE_BINARY_DIR}" PARENT_SCOPE)
endfunction()


#! Returns the command lines of the generator, which is started for the \c SCHEMA_FILE_NAME
function(get_generator_commands CASE_BINARY_DIR SCHEMA_FILE_NAME OUTPUT_COMMANDS)
	file(STRINGS "${CASE_BINARY_DIR}/build.ninja" NINJA_LINES REGEX "-GS [^ ]*${SCHEMA_FILE_NAME} ")
	set(${OUTPUT_COMMANDS} "${NINJA_LINES}" PARENT_SCOPE)
endfunction()


function(report CASE_NAME)
	if (CASE_ERROR)
		message(STATUS "FAIL: ${CASE_NAME}: ${CASE_ERROR}")
		math(EXPR FAILED "${FAILED_COUNT} + 1")
		set(FAILED_COUNT ${FAILED} PARENT_SCOPE)
	else()
		message(STATUS "PASS: ${CASE_NAME}")
	endif()
endfunction()


# the objects are generated by default: nothing about '--no-objects'
configure_case(cxx_objects TRUE "")
if (NOT CASE_ERROR)
	get_generator_commands("${CASE_BINARY_DIR}" "ArraySerialization.sdl" COMMANDS)
	if (NOT COMMANDS)
		set(CASE_ERROR "the generator command is not found")
	elseif ("${COMMANDS}" MATCHES "--no-objects")
		set(CASE_ERROR "unexpected '--no-objects' in: ${COMMANDS}")
	elseif (NOT "${COMMANDS}" MATCHES "--include-moc")
		set(CASE_ERROR "'--include-moc' is expected in: ${COMMANDS}")
	endif()
endif()
report(cxx_objects)

# NO_OBJECTS is forwarded by the 'CppQml' macro to the generator
configure_case(cxx_no_objects TRUE "")
if (NOT CASE_ERROR)
	get_generator_commands("${CASE_BINARY_DIR}" "ArraySerialization.sdl" COMMANDS)
	if (NOT "${COMMANDS}" MATCHES "--no-objects ")
		set(CASE_ERROR "'--no-objects' is expected in: ${COMMANDS}")
	endif()
endif()
report(cxx_no_objects)

configure_case(cpp_no_objects TRUE "")
if (NOT CASE_ERROR)
	get_generator_commands("${CASE_BINARY_DIR}" "ArraySerialization.sdl" COMMANDS)
	if (NOT "${COMMANDS}" MATCHES "--no-objects ")
		set(CASE_ERROR "'--no-objects' is expected in: ${COMMANDS}")
	endif()
endif()
report(cpp_no_objects)

# the flag belongs to a schema: the generator of the other schema gets neither '--no-objects' nor anything about the first one
configure_case(independent_flags TRUE "")
if (NOT CASE_ERROR)
	get_generator_commands("${CASE_BINARY_DIR}" "RequestedFields.sdl" COMMANDS)
	if (NOT COMMANDS)
		set(CASE_ERROR "the generator command is not found")
	elseif ("${COMMANDS}" MATCHES "--no-objects")
		set(CASE_ERROR "the schema with the objects must not be generated with '--no-objects': ${COMMANDS}")
	endif()
endif()
report(independent_flags)

# NO_OBJECTS is acceptable with QML: it affects only the C++ generator, the QML one is not changed
configure_case(qml_no_objects TRUE "")
if (NOT CASE_ERROR)
	get_generator_commands("${CASE_BINARY_DIR}" "ArraySerialization.sdl" COMMANDS)
	set(CPP_COMMAND "")
	set(QML_COMMAND "")
	foreach(COMMAND_LINE ${COMMANDS})
		if (COMMAND_LINE MATCHES "--QML")
			set(QML_COMMAND "${COMMAND_LINE}")
		elseif (COMMAND_LINE MATCHES "--CPP")
			set(CPP_COMMAND "${COMMAND_LINE}")
		endif()
	endforeach()

	if (NOT CPP_COMMAND OR NOT QML_COMMAND)
		set(CASE_ERROR "both the C++ and the QML generator commands are expected: ${COMMANDS}")
	elseif (NOT CPP_COMMAND MATCHES "--no-objects ")
		set(CASE_ERROR "'--no-objects' is expected in the C++ command: ${CPP_COMMAND}")
	elseif (QML_COMMAND MATCHES "--no-objects")
		set(CASE_ERROR "'--no-objects' is not expected in the QML command: ${QML_COMMAND}")
	endif()
endif()
report(qml_no_objects)

# different schemas must not produce the same file
configure_case(collision FALSE "SDL output file collision")
report(collision)

if (FAILED_COUNT GREATER 0)
	message(FATAL_ERROR "${FAILED_COUNT} SDL macro test(s) failed")
endif()
message(STATUS "All SDL macro tests passed")
