schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: imttag
	version: 1.0
}

import {
	"../../imtbase/1.0/ImtCollection.sdl"
}

# --- Tag catalog ---

type TagItemData {
	id: ID!
	typeId: ID!
	name: String!
	color: String
	description: String
	isSystem: Boolean
	usageCount: Integer
	added: String
	lastModified: String
}

type TagData {
	id: ID
	name: String
	color: String
	description: String
	isSystem: Boolean
}

input TagsListInput {
	viewParams: CollectionViewParams
}

type TagsListPayload {
	items: [TagItemData]
	notification: NotificationItem
}

input TagItemInput {
	id: ID!
}

input TagDataInput {
	id: ID!
	typeId: ID
	item: TagData!
	name: String
	description: String
}

# --- Tag assignments ---

input EntityTagsInput {
	entityType: String!
	entityIds: [ID]!
}

type EntityTags {
	entityId: ID!
	tags: [TagData]
}

type EntityTagsPayload {
	entityType: String
	items: [EntityTags]
}

input EntityTagsChangeInput {
	entityType: String!
	entityIds: [ID]!
	tagIds: [ID]
}

input EntityTagsSetInput {
	entityType: String!
	entityId: ID!
	tagIds: [ID]
}

type EntityTagChange {
	entityId: ID!
	addedTagIds: [ID]
	removedTagIds: [ID]
}

type EntityTagsChangedPayload {
	entityType: String
	changes: [EntityTagChange]
}

input TagsUsageInput {
	tagIds: [ID]!
}

type TagUsage {
	tagId: ID!
	count: Integer
}

type TagsUsagePayload {
	items: [TagUsage]
}

input EntityTypeInput {
	entityType: String!
}

type Query {
	TagsList (input: TagsListInput): TagsListPayload!
	TagItem (input: TagItemInput): TagData!
	EntityTagsGet (input: EntityTagsInput): EntityTagsPayload!
	TagsUsage (input: TagsUsageInput): TagsUsagePayload!
}

type Mutation {
	TagAdd (input: TagDataInput): AddedNotificationPayload!
	TagUpdate (input: TagDataInput): UpdatedNotificationPayload!
	EntityTagsAdd (input: EntityTagsChangeInput): EntityTagsChangedPayload!
	EntityTagsSet (input: EntityTagsSetInput): EntityTagsChangedPayload!
	EntityTagRemove (input: EntityTagsChangeInput): EntityTagsChangedPayload!
	EntityTagsClear (input: EntityTagsChangeInput): EntityTagsChangedPayload!
}

type Subscription {
	OnEntityTagsChanged (input: EntityTypeInput): EntityTagsChangedPayload!
}

collectionSchema {
	type Tag {
		ref: TagItemData
		operations {
			list: TagsList
		}
		subtype Tag {
			ref: TagData
			operations {
				get: TagItem
				update: TagUpdate
				insert: TagAdd
			}
		}
	}
}
