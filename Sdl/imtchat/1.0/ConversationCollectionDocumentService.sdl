schema {
	namespace: imtchat
	version: 1.0

	query: Query
	mutation: Mutation
}

import {
	"ImtChat.sdl"
	"../../imtbase/1.0/CollectionDocumentService.sdl"
	"../../imtbase/1.0/UndoManager.sdl"
}

type UpdateConversationInput {
	documentId: ID!
	conversation: ConversationData!
}

type Query {
	GetConversationRepresentation(input: DocumentId): ConversationData!
}

type Mutation {
	UpdateConversationFromRepresentation(input: UpdateConversationInput): DocumentOperationStatus!
}
