schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: imtchat
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

# --- Enums ---

enum ConversationType {
	Direct
	Group
	Channel
	Support
}

enum MessageStatus {
	Sent
	Delivered
	Read
}

enum TicketType {
	AccessRequest
	SupportRequest
	FeatureRequest
	BugReport
}

enum TicketStatus {
	Open
	InProgress
	Resolved
	Closed
}

enum TicketPriority {
	Low
	Medium
	High
	Critical
}

enum Environment {
	Development
	Staging
	Production
}

# --- Entity Reference ---

type EntityReferenceData {
	entityType: String!
	entityId: ID!
	displayName: String
	previewData: String
}

# --- Conversation ---

type ConversationItemData {
	id: ID!
	typeId: ID!
	name: String!
	lastMessage: String
	unreadCount: Int
	participantCount: Int
	updatedAt: String
}

type ConversationData {
	id: ID!
	name: String!
	conversationType: ConversationType
	participants: [ID]
	createdAt: String
	updatedAt: String
	metadata: String
}

input ConversationsListInput {
	viewParams: CollectionViewParams
}

type ConversationsListPayload {
	items: [ConversationItemData]
	notification: NotificationItem
}

input ConversationItemInput {
	id: ID!
}

input ConversationCreateInput {
	name: String!
	conversationType: ConversationType
	participantIds: [ID]
}

input ConversationDataInput {
	id: ID!
	item: ConversationData!
}

# --- Message ---

type MessageItemData {
	id: ID!
	typeId: ID!
	senderId: ID!
	senderName: String
	contentPreview: String
	createdAt: String
	status: MessageStatus
	hasEntityRefs: Boolean
}

type MessageData {
	id: ID!
	conversationId: ID!
	senderId: ID!
	content: String!
	entityReferences: [EntityReferenceData]
	attachmentIds: [ID]
	createdAt: String
	updatedAt: String
	status: MessageStatus
}

input MessagesListInput {
	conversationId: ID!
	viewParams: CollectionViewParams
}

type MessagesListPayload {
	items: [MessageItemData]
	notification: NotificationItem
}

input MessageItemInput {
	id: ID!
}

input MessageSendInput {
	conversationId: ID!
	content: String!
	entityReferences: [EntityReferenceData]
	attachmentIds: [ID]
}

input MessageDataInput {
	id: ID!
	item: MessageData!
}

input MessageMarkReadInput {
	conversationId: ID!
	messageId: ID!
}

# --- Ticket ---

type TicketItemData {
	id: ID!
	typeId: ID!
	title: String!
	ticketType: TicketType
	status: TicketStatus
	priority: TicketPriority
	assigneeId: ID
	createdAt: String
}

type TicketData {
	id: ID!
	title: String!
	description: String
	ticketType: TicketType
	status: TicketStatus
	priority: TicketPriority
	assigneeId: ID
	reporterId: ID
	conversationId: ID
	messageId: ID
	environment: Environment
	tags: [String]
	createdAt: String
	updatedAt: String
	resolvedAt: String
}

input TicketsListInput {
	viewParams: CollectionViewParams
}

type TicketsListPayload {
	items: [TicketItemData]
	notification: NotificationItem
}

input TicketItemInput {
	id: ID!
}

input TicketCreateInput {
	title: String!
	description: String
	ticketType: TicketType
	priority: TicketPriority
	assigneeId: ID
	conversationId: ID
	messageId: ID
	environment: Environment
	tags: [String]
}

input TicketDataInput {
	id: ID!
	item: TicketData!
}

# --- Subscription payloads ---

type MessageStatusUpdate {
	messageId: ID!
	conversationId: ID!
	status: MessageStatus!
}

type TicketStatusUpdate {
	ticketId: ID!
	status: TicketStatus!
	assigneeId: ID
}

type TypingIndicator {
	conversationId: ID!
	userId: ID!
	isTyping: Boolean!
}

type Query {
	ConversationsList (input: ConversationsListInput): ConversationsListPayload!
	ConversationItem (input: ConversationItemInput): ConversationData!
	MessagesList (input: MessagesListInput): MessagesListPayload!
	MessageItem (input: MessageItemInput): MessageData!
	TicketsList (input: TicketsListInput): TicketsListPayload!
	TicketItem (input: TicketItemInput): TicketData!
}

type Mutation {
	ConversationCreate (input: ConversationCreateInput): AddedNotificationPayload!
	ConversationUpdate (input: ConversationDataInput): UpdatedNotificationPayload!
	MessageSend (input: MessageSendInput): AddedNotificationPayload!
	MessageUpdate (input: MessageDataInput): UpdatedNotificationPayload!
	MessageMarkRead (input: MessageMarkReadInput): UpdatedNotificationPayload!
	TicketCreate (input: TicketCreateInput): AddedNotificationPayload!
	TicketUpdate (input: TicketDataInput): UpdatedNotificationPayload!
}

type Subscription {
	OnNewMessage (conversationId: ID!): MessageData!
	OnMessageStatusChanged (conversationId: ID!): MessageStatusUpdate!
	OnTicketStatusChanged (ticketId: ID): TicketStatusUpdate!
	OnTyping (conversationId: ID!): TypingIndicator!
	OnConversationUpdated: ConversationItemData!
}
