schema {
	namespace: imtbase
	version: 1.0
	query: Query
	subscription: Subscription
}

enum FileSystemEntryType {
	File
	Dir
	Symlink
	Drive
}

# Client-requested column sort for GetFileSystemEntries.
# Name is the default (dirs-first, case-insensitive).
# Date maps to lastModified for files/folders and freeBytes for drives.
# Size maps to size for files and totalBytes for drives (folders sort as 0).
enum FileSystemSortBy {
	Name
	Date
	Size
}

input GetFileSystemEntriesInput
{
	path: String
	offset: Int
	limit: Int
	# Case-insensitive name filter on the entry display name.
	# Default: shell-style glob (* = any chars, ? = one char; other characters
	# are literal — so "*.exe" works). Full PCRE regex when wrapped as /pattern/.
	# Invalid patterns fall back to literal substring match.
	# Applied before sort and pagination; totalCount/hasMore reflect the filter.
	nameFilter: String
	# Semicolon-separated list of file extensions to include (without the dot,
	# e.g. "exe;dll"). Case-insensitive; empty/absent = all files. Token "*"
	# (or "none") allows extensionless file names (Linux executables). Applies
	# to files only - folders are always listed so navigation is never blocked.
	# Applied before sort and pagination (totalCount/hasMore reflect it).
	extensionFilter: String
	sortBy: FileSystemSortBy
	# Default true (A→Z / oldest / smallest). false = reverse.
	sortAscending: Boolean
}

type FileSystemEntry
{
	name: String!
	path: String!
	entryType: FileSystemEntryType!
	# Byte counts are LongLong: files and volumes overflow a 32-bit Int.
	size: LongLong
	lastModified: String
	# Volume capacity, sent for Drive entries only.
	totalBytes: LongLong
	freeBytes: LongLong
}

type GetFileSystemEntriesPayload
{
	path: String!
	parentPath: String
	entries: [FileSystemEntry!]
	totalCount: Int!
	hasMore: Boolean!
}

input GetDownloadLinkInput
{
	# Path of a file as GetFileSystemEntries returns it.
	path: String!
}

type DownloadLink
{
	# Self-contained URL: a plain GET without other credentials.
	url: String!
	# Other URLs of the same content by priority. Not sent when there are none.
	alternativeUrls: [String!]
	# Until when the URLs are valid, ISO 8601 in UTC (e.g. "2024-06-05T12:34:56Z").
	# A hint only: the clocks of the client and of the source may differ.
	expiresAt: String
	size: LongLong
	# SHA-256 of the content, lowercase hex.
	sha256: String
	# Strong entity tag exactly as it goes in the ETag header, with the quotes.
	# The provider forms it; clients compare it as an opaque string.
	# Not sent when the source cannot resume a download.
	etag: String
}

type GetDownloadLinkPayload
{
	link: DownloadLink
}

input FileSystemSubscriptionInput
{
	# Path of a folder as GetFileSystemEntries returns it; empty for the root.
	path: String
}

# The content of the watched folder or the folder itself changed: the subscriber reads the folder again.
# The event carries no content, and events are not kept: after a reconnection the subscriber reads the folder again too.
type FileSystemChangedEvent
{
	# The path of the subscription.
	path: String!
}

type Query {
	GetFileSystemEntries(input: GetFileSystemEntriesInput): GetFileSystemEntriesPayload!
	GetDownloadLink(input: GetDownloadLinkInput): GetDownloadLinkPayload!
}

type Subscription {
	OnFileSystemChanged(input: FileSystemSubscriptionInput): FileSystemChangedEvent!
}
