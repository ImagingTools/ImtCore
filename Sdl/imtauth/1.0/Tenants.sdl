schema {
	query: Query
	mutation: Mutation
	namespace: imtauth
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtBaseTypes.sdl"
}

# --- Tenant ---

type TenantItemData {
	id: ID!
	typeId: ID!
	name: String!
	description: String
	ownerId: ID
	isActive: Boolean
	membersCount: Int
	createdAt: String
	updatedAt: String
	tenantRelationScope: String
	invitationId: ID
	invitedByName: String
	parentTenantId: ID
	isSystemTenant: Boolean
}

type TenantMemberEntry {
	id: ID!
	name: String!
}

input TenantMemberEntryInput {
	id: ID!
	name: String
}

type TenantMemberRoleEntry {
	userId: ID!
	role: String!
}

type TenantPermissionOption {
	id: ID!
	name: String!
	description: String
	children: [TenantPermissionOption]
}

type TenantInvitationEntry {
	id: ID!
	userId: ID!
	userName: String
	role: String!
	status: String!
	invitedByUserId: ID
	invitedByName: String
	createdAt: String
	expiresAt: String
}

type TenantData {
	id: ID
	name: String
	description: String
	ownerId: ID
	creatorId: ID
	isActive: Boolean
	createdAt: String
	updatedAt: String
	currentUserId: ID
	members: [TenantMemberEntry]
	memberRoles: [TenantMemberRoleEntry]
	pendingInvitations: [TenantInvitationEntry]
	tenantPermissions: [ID]
	allProductPermissions: [TenantPermissionOption]
	parentTenantId: ID
	isSystemTenant: Boolean
}

input GetTenantListInput {
	viewParams: CollectionViewParams
}

type GetTenantListPayload {
	items: [TenantItemData]
	notification: NotificationItem
}


# --- TenantManager operations ---

input GetTenantInput {
	tenantId: ID!
}

type GetTenantPayload {
	tenant: TenantData
	errorMessage: String
}

input CreateTenantInput {
	name: String!
	description: String
	ownerId: ID
	parentTenantId: ID
}

type CreateTenantPayload {
	tenantId: ID
	errorMessage: String
}

input RemoveTenantInput {
	tenantId: ID!
}

type RemoveTenantPayload {
	success: Boolean
	errorMessage: String
}

input MemberRoleEntryInput {
	userId: ID!
	role: String!
}

input UpdateTenantInput {
	tenantId: ID!
	name: String!
	description: String
	ownerId: ID
	members: [TenantMemberEntryInput]
	memberRoles: [MemberRoleEntryInput]
	tenantPermissions: [ID]
}

type UpdateTenantPayload {
	success: Boolean
	errorMessage: String
}

input SetTenantActiveInput {
	tenantId: ID!
	isActive: Boolean!
}

type SetTenantActivePayload {
	success: Boolean
	errorMessage: String
}

type GetTenantIdsPayload {
	tenantIds: [ID]
	errorMessage: String
}

# --- Tenant Environment Roles ---

enum TenantEnvironmentRole {
	Creator
	Owner
	Admin
	Member
}

# --- Tenant Relationships ---

enum TenantRelationshipRole {
	Parent
	Child
	Partner
	Supplier
	Customer
	Affiliate
}

type TenantRelationship {
	id: ID!
	sourceTenantId: ID!
	targetTenantId: ID!
	role: TenantRelationshipRole!
	sourceRole: TenantRelationshipRole
	targetRole: TenantRelationshipRole
	scope: String
	validFrom: String
	validUntil: String
	isActive: Boolean
	description: String
	createdAt: String
}

input AddTenantRelationshipInput {
	sourceTenantId: ID!
	targetTenantId: ID!
	role: TenantRelationshipRole!
	sourceRole: TenantRelationshipRole
	targetRole: TenantRelationshipRole
	scope: String
	validFrom: String
	validUntil: String
	description: String
}

type AddTenantRelationshipPayload {
	relationshipId: ID
	errorMessage: String
}

input RemoveTenantRelationshipInput {
	tenantId: ID!
	relationshipId: ID!
}

type RemoveTenantRelationshipPayload {
	success: Boolean
	errorMessage: String
}

input GetTenantRelationshipsInput {
	tenantId: ID!
}

type GetTenantRelationshipsPayload {
	relationships: [TenantRelationship]
	errorMessage: String
}

# --- Cross-Org Grants ---

enum CrossOrgAccessLevel {
	None
	Read
	Write
	Admin
}

type CrossOrgGrant {
	id: ID!
	sourceTenantId: ID!
	targetTenantId: ID!
	relationshipId: ID!
	targetTeamId: ID
	accessLevel: CrossOrgAccessLevel!
	resourceScope: String
	description: String
	createdAt: String
	expiresAt: String
	isActive: Boolean
}

input CreateCrossOrgGrantInput {
	sourceTenantId: ID!
	targetTenantId: ID!
	relationshipId: ID!
	accessLevel: CrossOrgAccessLevel!
	resourceScope: String
	targetTeamId: ID
	description: String
	expiresAt: String
}

type CreateCrossOrgGrantPayload {
	grantId: ID
	errorMessage: String
}

input RevokeCrossOrgGrantInput {
	grantId: ID!
}

type RevokeCrossOrgGrantPayload {
	success: Boolean
	errorMessage: String
}

input GetCrossOrgGrantsInput {
	tenantId: ID!
}

type GetCrossOrgGrantsPayload {
	grants: [CrossOrgGrant]
	errorMessage: String
}

# --- System Tenant ---

type EnsureSystemTenantPayload {
	success: Boolean
	systemTenantId: ID
	errorMessage: String
}

# --- Tenant Connection Requests (discovery / bootstrap) ---

enum TenantConnectionStatus {
	Pending
	Accepted
	Rejected
	Expired
	Revoked
}

type TenantConnectionRequest {
	id: ID!
	sourceTenantId: ID!
	targetTenantId: ID
	targetIdentifier: String
	connectCode: String
	proposedSourceRole: TenantRelationshipRole!
	proposedTargetRole: TenantRelationshipRole!
	message: String
	status: TenantConnectionStatus!
	createdAt: String
	expiresAt: String
	respondedAt: String
}

input CreateTenantConnectionRequestInput {
	sourceTenantId: ID!
	targetIdentifier: String!
	proposedSourceRole: TenantRelationshipRole!
	proposedTargetRole: TenantRelationshipRole!
	message: String
	expiresAt: String
}

type CreateTenantConnectionRequestPayload {
	requestId: ID
	errorMessage: String
}

input CreateTenantConnectCodeInput {
	sourceTenantId: ID!
	proposedSourceRole: TenantRelationshipRole!
	proposedTargetRole: TenantRelationshipRole!
	message: String
	expiresAt: String
}

type CreateTenantConnectCodePayload {
	requestId: ID
	connectCode: String
	errorMessage: String
}

input AcceptTenantConnectionRequestInput {
	requestId: ID!
	acceptingTenantId: ID!
}

type AcceptTenantConnectionRequestPayload {
	success: Boolean
	errorMessage: String
}

input AcceptTenantConnectCodeInput {
	connectCode: String!
	acceptingTenantId: ID!
}

type AcceptTenantConnectCodePayload {
	requestId: ID
	errorMessage: String
}

input RejectTenantConnectionRequestInput {
	requestId: ID!
}

type RejectTenantConnectionRequestPayload {
	success: Boolean
	errorMessage: String
}

input RevokeTenantConnectionRequestInput {
	requestId: ID!
}

type RevokeTenantConnectionRequestPayload {
	success: Boolean
	errorMessage: String
}

input GetTenantConnectionRequestsInput {
	tenantId: ID!
}

type GetTenantConnectionRequestsPayload {
	requests: [TenantConnectionRequest]
	errorMessage: String
}

# --- Cross-Tenant Messages (phase 2) ---

enum CrossTenantMessageType {
	Custom
	OrderRequest
	OrderConfirmation
	OrderRejection
	OrderStatusUpdate
	OrderCancellation
	DocumentShare
}

enum CrossTenantMessageStatus {
	Created
	Validated
	Delivered
	Acknowledged
	Processed
	Failed
	Expired
}

enum CrossTenantMessageDirection {
	Incoming
	Outgoing
}

type CrossTenantMessage {
	id: ID!
	sourceTenantId: ID!
	targetTenantId: ID!
	relationshipId: ID!
	sourceObjectId: ID
	targetObjectId: ID
	messageType: CrossTenantMessageType!
	customType: String
	payload: String
	status: CrossTenantMessageStatus!
	errorMessage: String
	createdAt: String
	updatedAt: String
	expiresAt: String
}

input SendCrossTenantMessageInput {
	sourceTenantId: ID!
	targetTenantId: ID!
	relationshipId: ID!
	messageType: CrossTenantMessageType!
	payload: String
	sourceObjectId: ID
	customType: String
	expiresAt: String
}

type SendCrossTenantMessagePayload {
	messageId: ID
	errorMessage: String
}

input GetCrossTenantMessageInput {
	messageId: ID!
}

type GetCrossTenantMessagePayload {
	message: CrossTenantMessage
	errorMessage: String
}

input GetCrossTenantMessagesInput {
	tenantId: ID!
	direction: CrossTenantMessageDirection
}

type GetCrossTenantMessagesPayload {
	messages: [CrossTenantMessage]
	errorMessage: String
}

input UpdateCrossTenantMessageStatusInput {
	messageId: ID!
	status: CrossTenantMessageStatus!
	errorMessage: String
}

type UpdateCrossTenantMessageStatusPayload {
	success: Boolean
	errorMessage: String
}

# --- Order Requests (phase 3) ---

enum OrderRequestStatus {
	Received
	Confirmed
	Rejected
	InProgress
	Completed
	Cancelled
}

type OrderRequest {
	id: ID!
	messageId: ID
	sourceTenantId: ID!
	targetTenantId: ID!
	relationshipId: ID
	sourceOrderId: ID
	articleNumber: String
	quantity: Int
	note: String
	status: OrderRequestStatus!
	statusNote: String
	createdAt: String
	updatedAt: String
}

input GetOrderRequestsInput {
	tenantId: ID!
}

type GetOrderRequestsPayload {
	orderRequests: [OrderRequest]
	errorMessage: String
}

input GetOrderRequestInput {
	orderRequestId: ID!
}

type GetOrderRequestPayload {
	orderRequest: OrderRequest
	errorMessage: String
}

input ConfirmOrderRequestInput {
	orderRequestId: ID!
	note: String
}

type ConfirmOrderRequestPayload {
	success: Boolean
	errorMessage: String
}

input RejectOrderRequestInput {
	orderRequestId: ID!
	reason: String
}

type RejectOrderRequestPayload {
	success: Boolean
	errorMessage: String
}

input UpdateOrderRequestStatusInput {
	orderRequestId: ID!
	status: OrderRequestStatus!
	note: String
}

type UpdateOrderRequestStatusPayload {
	success: Boolean
	errorMessage: String
}

type Query {
	GetTenantList (input: GetTenantListInput): GetTenantListPayload!
	GetTenant (input: GetTenantInput): GetTenantPayload!
	GetTenantIds: GetTenantIdsPayload!
	GetTenantRelationships (input: GetTenantRelationshipsInput): GetTenantRelationshipsPayload!
	GetCrossOrgGrants (input: GetCrossOrgGrantsInput): GetCrossOrgGrantsPayload!
	GetTenantConnectionRequests (input: GetTenantConnectionRequestsInput): GetTenantConnectionRequestsPayload!
	GetCrossTenantMessage (input: GetCrossTenantMessageInput): GetCrossTenantMessagePayload!
	GetCrossTenantMessages (input: GetCrossTenantMessagesInput): GetCrossTenantMessagesPayload!
	GetOrderRequest (input: GetOrderRequestInput): GetOrderRequestPayload!
	GetOrderRequests (input: GetOrderRequestsInput): GetOrderRequestsPayload!
}

type Mutation {
	CreateTenant (input: CreateTenantInput): CreateTenantPayload!
	RemoveTenant (input: RemoveTenantInput): RemoveTenantPayload!
	UpdateTenant (input: UpdateTenantInput): UpdateTenantPayload!
	SetTenantActive (input: SetTenantActiveInput): SetTenantActivePayload!
	AddTenantRelationship (input: AddTenantRelationshipInput): AddTenantRelationshipPayload!
	RemoveTenantRelationship (input: RemoveTenantRelationshipInput): RemoveTenantRelationshipPayload!
	CreateCrossOrgGrant (input: CreateCrossOrgGrantInput): CreateCrossOrgGrantPayload!
	RevokeCrossOrgGrant (input: RevokeCrossOrgGrantInput): RevokeCrossOrgGrantPayload!
	EnsureSystemTenant: EnsureSystemTenantPayload!
	CreateTenantConnectionRequest (input: CreateTenantConnectionRequestInput): CreateTenantConnectionRequestPayload!
	CreateTenantConnectCode (input: CreateTenantConnectCodeInput): CreateTenantConnectCodePayload!
	AcceptTenantConnectionRequest (input: AcceptTenantConnectionRequestInput): AcceptTenantConnectionRequestPayload!
	AcceptTenantConnectCode (input: AcceptTenantConnectCodeInput): AcceptTenantConnectCodePayload!
	RejectTenantConnectionRequest (input: RejectTenantConnectionRequestInput): RejectTenantConnectionRequestPayload!
	RevokeTenantConnectionRequest (input: RevokeTenantConnectionRequestInput): RevokeTenantConnectionRequestPayload!
	SendCrossTenantMessage (input: SendCrossTenantMessageInput): SendCrossTenantMessagePayload!
	UpdateCrossTenantMessageStatus (input: UpdateCrossTenantMessageStatusInput): UpdateCrossTenantMessageStatusPayload!
	ConfirmOrderRequest (input: ConfirmOrderRequestInput): ConfirmOrderRequestPayload!
	RejectOrderRequest (input: RejectOrderRequestInput): RejectOrderRequestPayload!
	UpdateOrderRequestStatus (input: UpdateOrderRequestStatusInput): UpdateOrderRequestStatusPayload!
}

collectionSchema {
	type Tenant {
		ref: TenantItemData
		operations {
			list: GetTenantList
		}
	}
}
