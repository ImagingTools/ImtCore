schema {
	query: Query
	mutation: Mutation
	namespace: imtauth
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtBaseTypes.sdl"
}

# --- Tenant ---

type TenantItemData {
	id: ID!
	typeId: ID!
	name: String!
	description: String
	isActive: Bool
	createdAt: String
}

type TenantData {
	id: ID
	name: String
	description: String
	isActive: Bool
	createdAt: String
	updatedAt: String
}

input GetTenantListInput {
	viewParams: CollectionViewParams
}

type GetTenantListPayload {
	items: [TenantItemData]
	notification: NotificationItem
}

input TenantDataInput {
	id: ID!
	typeId: ID!
	item: TenantData!
	name: String
	description: String
}

# --- TenantManager operations ---

input GetTenantInput {
	tenantId: ID!
}

type GetTenantPayload {
	tenant: TenantData
	errorMessage: String
}

input CreateTenantInput {
	name: String!
	description: String
}

type CreateTenantPayload {
	tenantId: ID
	errorMessage: String
}

input RemoveTenantInput {
	tenantId: ID!
}

type RemoveTenantPayload {
	success: Bool
	errorMessage: String
}

input UpdateTenantInput {
	tenantId: ID!
	name: String!
	description: String
}

type UpdateTenantPayload {
	success: Bool
	errorMessage: String
}

input SetTenantActiveInput {
	tenantId: ID!
	isActive: Bool!
}

type SetTenantActivePayload {
	success: Bool
	errorMessage: String
}

type Query {
	GetTenantList (input: GetTenantListInput): GetTenantListPayload!
	GetTenant (input: GetTenantInput): GetTenantPayload!
}

type Mutation {
	TenantUpdate (input: TenantDataInput): UpdatedNotificationPayload!
	TenantAdd (input: TenantDataInput): AddedNotificationPayload!
	CreateTenant (input: CreateTenantInput): CreateTenantPayload!
	RemoveTenant (input: RemoveTenantInput): RemoveTenantPayload!
	UpdateTenant (input: UpdateTenantInput): UpdateTenantPayload!
	SetTenantActive (input: SetTenantActiveInput): SetTenantActivePayload!
}

collectionSchema {
	type Tenant {
		ref: TenantItemData
		operations {
			list: GetTenantList
		}
		subtype Tenant {
			ref: TenantData
			operations {
				update: TenantUpdate
				insert: TenantAdd
			}
		}
	}
}

