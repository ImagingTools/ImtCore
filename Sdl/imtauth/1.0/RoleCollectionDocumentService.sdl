schema {
	namespace: imtauth
	version: 1.0

	query: Query
	mutation: Mutation
}

import {
	"Roles.sdl"
	"../../imtbase/1.0/CollectionDocumentService.sdl"
	"../../imtbase/1.0/UndoManager.sdl"
}

type UpdateRoleFromRepresentationInput {
	documentId: ID!
	role: RoleData!
}

type Query {
	GetRoleRepresentation(input: DocumentId): RoleData!
}

type Mutation {
	UpdateRoleFromRepresentation(input: UpdateRoleFromRepresentationInput): DocumentOperationStatus!
}
