schema {
	query: Query
	mutation: Mutation
	namespace: imtauth
	version: 1.0
}

import {
	"Assignments.sdl"
}

type ProfileTenantInfo {
	id: ID
	name: String
	description: String
	ownerId: ID
	role: String
	isOwner: Boolean
	isActive: Boolean
	isDelegated: Boolean
	delegatedRoles: [String]
}

type ProfileData {
	id: ID
	systemId: ID
	username: String
	name: String
	email: String
	currentTenantId: ID
	# What the user holds in the current organization and product, with the paths it comes through.
	roles: [Assignment]
	groups: [Assignment]
	permissions: [Assignment]
	accessWarnings: [AccessWarning]
}

type GetUserOrganizationsPayload {
	organizations: [ProfileTenantInfo]
}

type SetProfileResponse {
	status: Boolean
}

type GetProfileInput {
	id: ID!
	productId: ID!
}

type SetProfileInput {
	id: ID!
	name: String
	email: String
}

type Query {
	GetProfile (input: GetProfileInput): ProfileData!
	GetUserOrganizations (input: GetProfileInput): GetUserOrganizationsPayload!
}

type Mutation {
	SetProfile (input: SetProfileInput): SetProfileResponse!
}


