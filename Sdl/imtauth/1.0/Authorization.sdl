schema {
	query: Query
	mutation: Mutation
	namespace: imtauth
	version: 1.0
}

type AuthorizationPayload {
	userId: ID
	username: ID
	token: ID
	refreshToken: ID
	systemId: ID
	permissions: ID
	passwordExpired: Boolean
	passwordExpiresInDays: Int
	accountDisabled: Boolean
}

input AuthorizationInput {
	login: String!
	password: String!
	productId: ID
}

input TokenInput {
	accessToken: ID!
}

type LogoutPayload {
	ok: Boolean
}

type PermissionList {
	permissions: [ID]!
}

type ExternalLoginProvider {
	id: ID!
	name: String!
	providerType: ID!
}

type ExternalLoginProviderList {
	providers: [ExternalLoginProvider]!
}

input BeginExternalLoginInput {
	providerId: ID!
	productId: ID
	link: Boolean
}

type BeginExternalLoginPayload {
	loginId: ID
	authorizationUrl: String
	message: String
}

input ExternalLoginInput {
	loginId: ID!
}

type ExternalLoginPayload {
	status: ID!
	message: String
	authorization: AuthorizationPayload
}

input ExternalLoginCallbackInput {
	state: ID!
	code: String
	error: String
}

type ExternalLoginCallbackPayload {
	ok: Boolean!
	message: String
}

type ExternalIdentity {
	providerId: ID!
	providerName: String
	providerType: ID
	email: String
	linkedAt: String
	lastSignInAt: String
}

type ExternalIdentityList {
	identities: [ExternalIdentity]!
	hasPassword: Boolean
}

input UnlinkExternalIdentityInput {
	providerId: ID!
}

type UnlinkExternalIdentityPayload {
	ok: Boolean!
	message: String
}

type Query {
	Authorization (input: AuthorizationInput): AuthorizationPayload!
	UserToken (input: AuthorizationInput): AuthorizationPayload!
	GetPermissions (input: TokenInput): PermissionList!
	GetExternalLoginProviders: ExternalLoginProviderList!
	GetExternalIdentities: ExternalIdentityList!
}

type Mutation {
	Logout (input: TokenInput): LogoutPayload!
	BeginExternalLogin (input: BeginExternalLoginInput): BeginExternalLoginPayload!
	CompleteExternalLogin (input: ExternalLoginInput): ExternalLoginPayload!
	HandleExternalLoginCallback (input: ExternalLoginCallbackInput): ExternalLoginCallbackPayload!
	UnlinkExternalIdentity (input: UnlinkExternalIdentityInput): UnlinkExternalIdentityPayload!
}
