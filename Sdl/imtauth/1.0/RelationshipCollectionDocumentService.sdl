schema {
	namespace: imtauth
	version: 1.0

	query: Query
	mutation: Mutation
}

import {
	"Tenants.sdl"
	"../../imtbase/1.0/CollectionDocumentService.sdl"
	"../../imtbase/1.0/UndoManager.sdl"
}

type UpdateRelationshipFromRepresentationInput {
	documentId: ID!
	relationship: TenantRelationship!
}

type Query {
	GetRelationshipRepresentation(input: DocumentId): TenantRelationship!
}

type Mutation {
	UpdateRelationshipFromRepresentation(input: UpdateRelationshipFromRepresentationInput): DocumentOperationStatus!
}
