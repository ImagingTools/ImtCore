schema {
	query: Query
	mutation: Mutation
	namespace: imtauth
	version: 1.0
}

import {
	"../../imtbase/1.0/ImtCollection.sdl"
	"Permissions.sdl"
}

# A personal access token without an owner: it identifies a server of a product.
type ServerToken
{
	id: ID!
	clientProductId: ID!
	productId: ID!
	name: String!
	description: String
	scopes: [ID]
	createdAt: String
	lastUsedAt: String
	revoked: Bool
}

type ServerTokenList
{
	tokens: [ServerToken]
}

input ServerTokenListInput {
	clientProductId: ID!
}

input CreateServerTokenInput {
	clientProductId: ID!
	productId: ID!
	name: String!
	description: String
	scopes: [ID]
}

type CreateServerTokenPayload {
	id: ID
	token: ID
	success: Boolean!
	message: String
}

type RevokeServerTokenPayload {
	success: Boolean!
	message: String
}

# What a server token can be allowed on its receiving server: the permission tree of that server.
type ServerTokenReceiver
{
	productId: ID!
	groups: [PermissionGroup]
	# Held by every token for this server.
	requiredPermissions: [ID]
}

# A permission of the receiving server with its sub-permissions.
type ServerFeature
{
	featureId: ID!
	name: String
	description: String
	requirements: [ID]
	subFeatures: [ServerFeature]
}

type ServerFeatureList
{
	features: [ServerFeature]
}

type ServerTokenReceiverList
{
	productServers: [ServerTokenReceiver]
}

input ServerTokenReceiversInput {
	clientProductId: ID
}

input UpdateServerTokenScopesInput {
	id: ID!
	scopes: [ID]
}

type Query {
	GetServerTokenList (input: ServerTokenListInput!): ServerTokenList!
	GetServerTokenReceivers (input: ServerTokenReceiversInput): ServerTokenReceiverList!
	# The permissions of this server the token of the calling product server allows, for the roles of that product.
	GetServerTokenFeatures: ServerFeatureList!
}

type Mutation {
	CreateServerToken (input: CreateServerTokenInput!): CreateServerTokenPayload!
	RevokeServerToken (input: InputId!): RevokeServerTokenPayload!
	UpdateServerTokenScopes (input: UpdateServerTokenScopesInput!): RevokeServerTokenPayload!
}
