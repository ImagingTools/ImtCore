schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: imtauth
	version: 1.0
}

import {
	"../../imtbase/1.0/ImtCollection.sdl"
}

input ConnectedProductsListInput {
	viewParams: CollectionViewParams
}

type ConnectedProductItemData {
	typeId: ID!
	id: ID!
	productId: ID
	productName: String!
	productDescription: String
	added: String
	lastModified: String
}

type ConnectedProductsListPayload {
	items: [ConnectedProductItemData]
	notification: NotificationItem
}

type ConnectedProductData {
	id: ID
	productId: ID
	name: String
	description: String
}

input ConnectedProductDataInput {
	id: ID!
	typeId: ID!
	item: ConnectedProductData!
	name: String
	description: String
}

input ConnectedProductItemInput {
	id: ID!
}

type Query {
	ConnectedProductsList (input: ConnectedProductsListInput): ConnectedProductsListPayload!
	ConnectedProductItem (input: ConnectedProductItemInput): ConnectedProductData!
}

type Mutation {
	ConnectedProductUpdate (input: ConnectedProductDataInput): UpdatedNotificationPayload!
	ConnectedProductAdd (input: ConnectedProductDataInput): AddedNotificationPayload!
}

collectionSchema {
	type ConnectedProduct {
		ref: ConnectedProductItemData
		operations {
			list: ConnectedProductsList
		}
		subtype ConnectedProduct {
			ref: ConnectedProductData
			operations {
				get: ConnectedProductItem
				update: ConnectedProductUpdate
				insert: ConnectedProductAdd
			}
		}
	}
}
