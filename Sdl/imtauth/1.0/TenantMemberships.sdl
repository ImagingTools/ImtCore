schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: imtauth
	version: 1.0
}

import {
	"../../imtbase/1.0/ImtCollection.sdl"
	"../../imtbase/1.0/ImtBaseTypes.sdl"
	"Permissions.sdl"
}

# --- TenantMembership ---

enum TenantInvitationStatus {
	Pending
	Accepted
	Rejected
	Revoked
	Expired
}

type TenantMembershipItemData {
	id: ID!
	typeId: ID!
	userId: ID!
	tenantId: ID!
	isActive: Boolean
	joinedAt: String
	updatedAt: String
}

type TenantMembershipData {
	id: ID
	userId: ID
	tenantId: ID
	isActive: Boolean
	joinedAt: String
	updatedAt: String
	organizationPermissions: [ID]
}

type TenantInvitationData {
	id: ID
	userId: ID
	tenantId: ID
	tenantName: String
	status: TenantInvitationStatus
	invitedByUserId: ID
	createdAt: String
	updatedAt: String
	expiresAt: String
	acceptedAt: String
	rejectedAt: String
	revokedAt: String
	revokedByUserId: ID
	lastSentAt: String
}

# --- Queries ---

input GetMembershipsByTenantInput {
	tenantId: ID!
}

type GetMembershipsByTenantPayload {
	membershipIds: [ID]
	errorMessage: String
}

input GetMembershipsByUserInput {
	userId: ID!
}

type GetMembershipsByUserPayload {
	membershipIds: [ID]
	errorMessage: String
}

input GetMembershipInput {
	membershipId: ID!
}

type GetMembershipPayload {
	membership: TenantMembershipData
	errorMessage: String
}

input FindMembershipInput {
	userId: ID!
	tenantId: ID!
}

type FindMembershipPayload {
	membership: TenantMembershipData
	errorMessage: String
}

input IsMemberInput {
	userId: ID!
	tenantId: ID!
}

type IsMemberPayload {
	isMember: Boolean
	errorMessage: String
}

input HasMinimumRoleInput {
	userId: ID!
	tenantId: ID!
	minimumRole: ID!
}

type HasMinimumRolePayload {
	hasRole: Boolean
	errorMessage: String
}

input GetOrganizationPermissionsInput {
	tenantId: ID
	userId: ID
}

type GetOrganizationPermissionsPayload {
	groups: [PermissionGroup]
	memberPermissions: [ID]
	errorMessage: String
}

input GetTenantInvitationsInput {
	tenantId: ID!
	statuses: [TenantInvitationStatus]
}

type GetTenantInvitationsPayload {
	invitations: [TenantInvitationData]
	errorMessage: String
}

input GetMyTenantInvitationsInput {
	statuses: [TenantInvitationStatus]
}

type GetMyTenantInvitationsPayload {
	invitations: [TenantInvitationData]
	errorMessage: String
}

# --- Mutations ---

input AddMembershipInput {
	userId: ID!
	tenantId: ID!
}

type AddMembershipPayload {
	membershipId: ID
	errorMessage: String
}

input CreateTenantInvitationInput {
	userId: ID!
	tenantId: ID!
}

type CreateTenantInvitationPayload {
	invitationId: ID
	errorMessage: String
}

input AcceptTenantInvitationInput {
	invitationId: ID!
}

type AcceptTenantInvitationPayload {
	membershipId: ID
	success: Boolean
	errorMessage: String
}

input RejectTenantInvitationInput {
	invitationId: ID!
}

type RejectTenantInvitationPayload {
	success: Boolean
	errorMessage: String
}

input RevokeTenantInvitationInput {
	invitationId: ID!
}

type RevokeTenantInvitationPayload {
	success: Boolean
	errorMessage: String
}

input ResendTenantInvitationInput {
	invitationId: ID!
}

type ResendTenantInvitationPayload {
	success: Boolean
	errorMessage: String
}

input RemoveMembershipInput {
	membershipId: ID!
}

type RemoveMembershipPayload {
	success: Boolean
	errorMessage: String
}

input UpdateMembershipPermissionsInput {
	membershipId: ID!
	permissions: [ID]
}

type UpdateMembershipPermissionsPayload {
	success: Boolean
	errorMessage: String
}

input TransferTenantOwnershipInput {
	tenantId: ID!
	newOwnerId: ID!
}

type TransferTenantOwnershipPayload {
	success: Boolean
	errorMessage: String
}

type Query {
	GetMembershipsByTenant (input: GetMembershipsByTenantInput): GetMembershipsByTenantPayload!
	GetMembershipsByUser (input: GetMembershipsByUserInput): GetMembershipsByUserPayload!
	GetMembership (input: GetMembershipInput): GetMembershipPayload!
	FindMembership (input: FindMembershipInput): FindMembershipPayload!
	IsMember (input: IsMemberInput): IsMemberPayload!
	HasMinimumRole (input: HasMinimumRoleInput): HasMinimumRolePayload!
	GetTenantInvitations (input: GetTenantInvitationsInput): GetTenantInvitationsPayload!
	GetMyTenantInvitations (input: GetMyTenantInvitationsInput): GetMyTenantInvitationsPayload!
	GetOrganizationPermissions (input: GetOrganizationPermissionsInput): GetOrganizationPermissionsPayload!
}

type Mutation {
	AddMembership (input: AddMembershipInput): AddMembershipPayload!
	CreateTenantInvitation (input: CreateTenantInvitationInput): CreateTenantInvitationPayload!
	AcceptTenantInvitation (input: AcceptTenantInvitationInput): AcceptTenantInvitationPayload!
	RejectTenantInvitation (input: RejectTenantInvitationInput): RejectTenantInvitationPayload!
	RevokeTenantInvitation (input: RevokeTenantInvitationInput): RevokeTenantInvitationPayload!
	ResendTenantInvitation (input: ResendTenantInvitationInput): ResendTenantInvitationPayload!
	RemoveMembership (input: RemoveMembershipInput): RemoveMembershipPayload!
	UpdateMembershipPermissions (input: UpdateMembershipPermissionsInput): UpdateMembershipPermissionsPayload!
	TransferTenantOwnership (input: TransferTenantOwnershipInput): TransferTenantOwnershipPayload!
}

# --- Subscriptions ---

enum EMembershipNotificationType {
	InvitationReceived
	InvitationAccepted
	InvitationRejected
	OwnershipTransferred
	MembershipRoleChanged
	MembershipRemoved
	InvitationRevoked
}

type MembershipNotification {
	notificationType: EMembershipNotificationType!
	membershipId: ID!
	userId: ID!
	tenantId: ID!
	tenantName: String
	role: ID
}

input MembershipSubscriptionInput {
	userId: ID!
}

type Subscription {
	OnMembershipNotification(input: MembershipSubscriptionInput): MembershipNotification!
}
