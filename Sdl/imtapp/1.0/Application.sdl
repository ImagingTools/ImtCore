schema {
	query: Query
	namespace: imtapp
	version: 1.0
}

import {
	"../../imtbase/1.0/ImtBaseTypes.sdl"
}

enum UserManagementMode {
	NO_USER_MANAGEMENT
	OPTIONAL_USER_MANAGEMENT
	STRONG_USER_MANAGEMENT
}

# Local copy of imtauth's ExistsStatus/CheckSuperuserPayload shape. Deliberately
# not imported from imtauth/1.0/Users.sdl - imtapp is a lower layer that imtauth
# itself depends on (via imtservergql), and importing back from imtauth closes a
# cyclic SDL/library dependency that CMake's strong imtservergql->imtappsdl
# add_dependencies (AUTOMOC autogen target) cannot tolerate.
enum SuperuserExistsStatus {
	EXISTS
	NOT_EXISTS
	UNKNOWN
}

type SuperuserCheckResult {
	status: SuperuserExistsStatus
	message: String
}

type ApplicationInfo {
	version: String
	companyName: String
	productName: String
	applicationId: String
	applicationName: String
	applicationType: String
	logoIconName: String
	webSocketUrl: UrlParam
	userMode: UserManagementMode
	superuser: SuperuserCheckResult
}

input GetApplicationInfoInput {
	productId: ID
}

type Query {
	GetApplicationInfo (input: GetApplicationInfoInput): ApplicationInfo!
}


