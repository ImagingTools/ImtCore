schema {
	query: Query
	namespace: imtapp
	version: 1.0
}

import {
	"../../imtbase/1.0/ImtBaseTypes.sdl"
	"../../imtauth/1.0/Users.sdl"
}

enum UserManagementMode {
	NO_USER_MANAGEMENT
	OPTIONAL_USER_MANAGEMENT
	STRONG_USER_MANAGEMENT
}

type ApplicationInfo {
	version: String
	companyName: String
	productName: String
	applicationId: String
	applicationName: String
	applicationType: String
	logoIconName: String
	webSocketUrl: UrlParam
	userMode: UserManagementMode
	superuser: CheckSuperuserPayload
}

input GetApplicationInfoInput {
	productId: ID
}

type Query {
	GetApplicationInfo (input: GetApplicationInfoInput): ApplicationInfo!
}


