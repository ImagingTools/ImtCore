schema {
	namespace: imtdesk
	version: 1.0

	query: Query
	mutation: Mutation
}

import {
	"ImtDesk.sdl"
	"../../imtbase/1.0/CollectionDocumentService.sdl"
	"../../imtbase/1.0/UndoManager.sdl"
}

type UpdateTicketInput {
	documentId: ID!
	ticket: TicketData!
}

type Query {
	GetTicketRepresentation(input: DocumentId): TicketData!
}

type Mutation {
	UpdateTicketFromRepresentation(input: UpdateTicketInput): DocumentOperationStatus!
}
