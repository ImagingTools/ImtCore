schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: imtdesk
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

# --- Enums ---

enum TicketType {
	AccessRequest
	SupportRequest
	FeatureRequest
	BugReport
}

enum TicketStatus {
	Open
	Closed
}

enum StateReason {
	None
	Completed
	NotPlanned
	Reopened
}

enum TicketPriority {
	Low
	Medium
	High
	Critical
}

enum Environment {
	Development
	Staging
	Production
}

# --- Label ---

type LabelData {
	id: ID!
	name: String!
	color: String!
	description: String
}

# --- Milestone ---

enum MilestoneState {
	Open
	Closed
}

type MilestoneData {
	id: ID!
	title: String!
	description: String
	state: MilestoneState
	dueOn: String
	createdAt: String
	closedAt: String
}

# --- Ticket ---

type TicketItemData {
	id: ID!
	typeId: ID!
	number: Int
	title: String!
	ticketType: TicketType
	status: TicketStatus
	stateReason: StateReason
	priority: TicketPriority
	assigneeIds: [ID]
	labelIds: [ID]
	milestoneId: ID
	locked: Boolean
	createdAt: String
}

type TicketData {
	id: ID!
	number: Int
	title: String!
	description: String
	ticketType: TicketType
	status: TicketStatus
	stateReason: StateReason
	priority: TicketPriority
	assigneeIds: [ID]
	reporterId: ID
	conversationId: ID
	messageId: ID
	environment: Environment
	tags: [String]
	labelIds: [ID]
	milestoneId: ID
	locked: Boolean
	lockReason: String
	createdAt: String
	updatedAt: String
	closedAt: String
	resolvedAt: String
}

input TicketsListInput {
	viewParams: CollectionViewParams
}

type TicketsListPayload {
	items: [TicketItemData]
	notification: NotificationItem
}

input TicketItemInput {
	id: ID!
}

input TicketDataInput {
	id: ID!
	item: TicketData!
}

# --- Subscription payloads ---

type TicketId {
	ticketId: ID!
}

type TicketStatusUpdate {
	ticketId: ID!
	status: TicketStatus!
	assigneeId: ID
}

type Query {
	TicketsList (input: TicketsListInput): TicketsListPayload!
	TicketItem (input: TicketItemInput): TicketData!
}

type Mutation {
	TicketCreate (input: TicketDataInput): AddedNotificationPayload!
	TicketUpdate (input: TicketDataInput): UpdatedNotificationPayload!
}

collectionSchema {
	type Ticket {
		ref: TicketItemData
		operations {
			list: TicketsList
		}
		subtype Ticket {
			ref: TicketData
			operations {
				get: TicketItem
				update: TicketUpdate
				insert: TicketCreate
			}
		}
	}
}
