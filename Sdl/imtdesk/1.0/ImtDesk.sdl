schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: imtdesk
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtBaseTypes.sdl"
}

# --- Enums ---

enum TicketType {
	AccessRequest
	SupportRequest
	FeatureRequest
	BugReport
}

enum TicketStatus {
	Open
	Closed
}

enum StateReason {
	None
	Completed
	NotPlanned
	Reopened
}

enum TicketPriority {
	Low
	Medium
	High
	Critical
}

# --- Label ---

type LabelData {
	id: ID!
	name: String!
	color: String!
	description: String
}

# --- Entity Type ---

type EntityType {
	id: String
	name: String
}

# --- Entity Reference ---

type EntityReference {
	entityType: String
	entityId: ID
	displayName: String
	entityLink: ObjectLink
}

# --- Attachment ---

type Attachment {
	id: ID
	fileName: String
	mimeType: String
	data: String
	preview: String
}

# --- Comment ---

type TicketComment {
	id: ID
	userId: ID
	userName: String
	timestamp: String
	content: String
	attachments: [Attachment]
	reactions: [String]
}

# --- Ticket ---

type TicketItemData {
	id: ID!
	typeId: ID!
	number: Int
	title: String!
	ticketType: TicketType
	status: TicketStatus
	priority: TicketPriority
	assignee: String
	createdAt: String
}

type TicketData {
	id: ID!
	number: Int
	title: String!
	description: String
	ticketType: TicketType
	status: TicketStatus
	stateReason: StateReason
	priority: TicketPriority
	assigneeIds: [ID]
	reporterId: ID
	conversationId: ID
	messageId: ID
	tags: [String]
	labelIds: [ID]
	locked: Boolean
	lockReason: String
	createdAt: String
	updatedAt: String
	closedAt: String
	resolvedAt: String
	entityReferences: [EntityReference]
	entityTypes: [EntityType]
	comments: [TicketComment]
}

input TicketsListInput {
	viewParams: CollectionViewParams
}

type TicketsListPayload {
	items: [TicketItemData]
	notification: NotificationItem
}

input TicketItemInput {
	id: ID!
}

input TicketDataInput {
	id: ID!
	item: TicketData!
}

# --- Subscription payloads ---

type TicketId {
	ticketId: ID!
}

type TicketStatusUpdate {
	ticketId: ID!
	status: TicketStatus!
	assigneeId: ID
}

type Query {
	TicketsList (input: TicketsListInput): TicketsListPayload!
	TicketItem (input: TicketItemInput): TicketData!
}

type Mutation {
	TicketCreate (input: TicketDataInput): AddedNotificationPayload!
	TicketUpdate (input: TicketDataInput): UpdatedNotificationPayload!
}

collectionSchema {
	type Ticket {
		ref: TicketItemData
		operations {
			list: TicketsList
		}
		subtype Ticket {
			ref: TicketData
			operations {
				get: TicketItem
				update: TicketUpdate
				insert: TicketCreate
			}
		}
	}
}
