@PACKAGE_INIT@

# ---------------------------------------------------------------------------
# CMake package configuration for the ImtCore module.
#
# Usage in a consuming project:
#
#     find_package(ImtCore REQUIRED)
#     target_link_libraries(myTarget PUBLIC ImtCore::imtbase ImtCore::imtgui)
#
# All ImtCore libraries are exposed as imported targets under the "ImtCore::"
# namespace and carry their include directories and inter-library dependencies
# (including the dependencies onto the underlying Acf::, AcfSln:: and IAcf::
# libraries) as transitive usage requirements.
# ---------------------------------------------------------------------------

include(CMakeFindDependencyMacro)

# ImtCore is built on top of the ACF, ACF-Solutions and IAcf foundations; pull in
# their packages so the Acf::<lib> / AcfSln::<lib> / IAcf::<lib> imported targets
# referenced by the exported ImtCore targets resolve. find_package(IAcf) already
# pulls in Acf and AcfSln through its own find_dependency() calls.
#
# NOTE: find_package() is used instead of find_dependency() for IAcf because
# find_dependency propagates REQUIRED from the outer find_package(ImtCore REQUIRED)
# call, making the lookup fatal even with QUIET.
find_package(IAcf QUIET)
if(NOT IAcf_FOUND)
	find_dependency(AcfSln REQUIRED)
endif()

# ImtCore was built against a specific Qt major version; pin the very same one so
# the Qt imported targets referenced by the exported ImtCore targets
# (Qt@IMTCORE_QT_VERSION_MAJOR@::*) resolve to a compatible Qt installation.
set(IMTCORE_QT_VERSION_MAJOR "@IMTCORE_QT_VERSION_MAJOR@")

set(_imtcore_qt_components Core Gui Widgets Xml Network Svg Sql WebSockets Concurrent PrintSupport)

if(IMTCORE_QT_VERSION_MAJOR EQUAL 5)
	list(APPEND _imtcore_qt_components XmlPatterns)
endif()
if(IMTCORE_QT_VERSION_MAJOR EQUAL 6)
	list(APPEND _imtcore_qt_components Core5Compat SvgWidgets OpenGLWidgets)
endif()

find_dependency(Qt${IMTCORE_QT_VERSION_MAJOR}
	COMPONENTS ${_imtcore_qt_components})

# The exported ImtCore targets reference third-party imported targets in their link
# interface: OpenSSL::Crypto (imtcrypt) and QuaZip::QuaZip (imtrest). Resolve their
# packages here so those targets exist before ImtCoreTargets.cmake is included.
#
# Promote the OpenSSL/QuaZip imported targets to global scope. Consumers pull ImtCore
# in with find_package(ImtCore GLOBAL), which promotes the ImtCore:: targets to global
# but does NOT propagate GLOBAL into these nested find_dependency() calls. Without the
# promotion the global ImtCore::imtcrypt / ImtCore::imtrest targets would reference
# directory-scoped OpenSSL::Crypto / QuaZip::QuaZip targets, so consumers had to
# pre-find OpenSSL/QuaZip with GLOBAL themselves. Doing it centrally here removes that
# need. Requires CMake >= 3.24 (project mandates >= 3.26).
set(_imtcore_prev_targets_global "${CMAKE_FIND_PACKAGE_TARGETS_GLOBAL}")
set(CMAKE_FIND_PACKAGE_TARGETS_GLOBAL TRUE)
find_dependency(OpenSSL)
find_dependency(QuaZip)
set(CMAKE_FIND_PACKAGE_TARGETS_GLOBAL "${_imtcore_prev_targets_global}")
unset(_imtcore_prev_targets_global)

include("${CMAKE_CURRENT_LIST_DIR}/ImtCoreTargets.cmake")

check_required_components(ImtCore)
