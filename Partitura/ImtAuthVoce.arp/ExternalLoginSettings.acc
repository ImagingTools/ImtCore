                                <Value>OpenID Connect Provider Name</Value>
                                <Value>OpenID Connect Authorization Endpoint</Value>
                                <Value>OpenID Connect Token Endpoint</Value>
                                <Value>OpenID Connect User Info Endpoint</Value>
                                <Value>OpenID Connect Issuer</Value>
                                <Value>OpenID Connect Client ID</Value>
                                <Value>OpenID Connect Client Secret</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="TypeId" Type="Id" ExportId="">
