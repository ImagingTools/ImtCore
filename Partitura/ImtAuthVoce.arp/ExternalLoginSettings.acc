        <Element Id="ExternalLoginParams" PackageId="BasePck" ComponentId="ComposedParamsSet">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="Parameters" Type="Reference[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>CallbackUrlParam</Value>
                                <Value>GoogleClientIdParam</Value>
                                <Value>GoogleClientSecretParam</Value>
