                    <AttributeInfo Id="ParametersDescription" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>Public URL of the sign-in callback, registered at the providers as redirect URI</Value>
                                <Value></Value>
                                <Value></Value>
                                <Value>Services ID</Value>
                                <Value>Client secret JWT signed with the Sign in with Apple key</Value>
                                <Value></Value>
                                <Value></Value>
                                <Value>Name shown on the sign-in button</Value>
                                <Value></Value>
                                <Value></Value>
                                <Value>Optional, the claims of the ID token are used without it</Value>
                                <Value>Expected 'iss' claim of the ID token</Value>
                                <Value></Value>
                                <Value></Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ParametersId" Type="Id[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>CallbackUrl</Value>
                                <Value>GoogleClientId</Value>
                                <Value>GoogleClientSecret</Value>
                                <Value>AppleClientId</Value>
                                <Value>AppleClientSecret</Value>
                                <Value>FacebookClientId</Value>
                                <Value>FacebookClientSecret</Value>
                                <Value>OidcProviderName</Value>
                                <Value>OidcAuthorizationEndpoint</Value>
                                <Value>OidcTokenEndpoint</Value>
                                <Value>OidcUserInfoEndpoint</Value>
                                <Value>OidcIssuer</Value>
                                <Value>OidcClientId</Value>
                                <Value>OidcClientSecret</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ParametersName" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
