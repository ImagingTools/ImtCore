<?xml version="1.0" encoding="UTF-8"?>
<Acf>
    <AcfHeader>
        <VersionInfos>
            <Version Id="0" Number="6390" Description="ACF"/>
            <Version Id="1" Number="2306" Description="ACF-Solutions"/>
            <Version Id="1023" Number="395264" Description="Qt Framework"/>
        </VersionInfos>
    </AcfHeader>
    <Description>Sign-in with Google, Apple and Facebook accounts; a provider is offered once its client ID is set in the settings</Description>
    <Keywords>OIDC OAuth Google Apple Facebook</Keywords>
    <ElementsList>
        <Element Id="AppleProvider" PackageId="ImtAuthPck" ComponentId="AppleOidcProvider">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="ClientIdParam" Type="Reference" ExportId="AppleClientIdParam">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ClientSecretParam" Type="Reference" ExportId="AppleClientSecretParam">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ExternalIdentity" PackageId="ImtAuthPck" ComponentId="ExternalIdentity">
            <Data IsEnabled="true" Flags="2">
                <AttributeInfoMap/>
            </Data>
        </Element>
