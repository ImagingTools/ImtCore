<?xml version="1.0" encoding="UTF-8"?>
<Acf>
    <AcfHeader>
        <VersionInfos>
            <Version Id="0" Number="6637" Description="ACF"/>
            <Version Id="1" Number="2463" Description="ACF-Solutions"/>
            <Version Id="1023" Number="396033" Description="Qt Framework"/>
        </VersionInfos>
    </AcfHeader>
    <Description>AI assistant of a server: configuration per tenant in the administration, knowledge of the product (KnowledgeDocuments), the public API from the SDL files (ApiSchemaPaths) with the policy AllowedQueries/AllowedMutations/ForbiddenCommands, plans of changes (checked for later changes of their objects through DocumentActionJournal and RollbackDelegates), the rollback of confirmed document actions (DocumentActionJournal with RollbackCollections/RollbackDelegates and their permissions) and the shared administration actions. Export: the GraphQL handlers AssistantController and ConfigurationController. Needs ConfigurationCollection, SecretProtector and RequestHandlers (the GraphQL handlers of the application). Call Init::InitAssistantServer().</Description>
    <Keywords>Assistant AI Tenant Administration Server Knowledge API Agent</Keywords>
    <ElementsList>
        <Element Id="ActionRegistry" PackageId="ImtAssistPck" ComponentId="AssistantActionRegistry">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="Actions" Type="Reference[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>KnowledgeSearch</Value>
                                <Value>KnowledgeRead</Value>
                                <Value>ApiList</Value>
                                <Value>ApiDescribe</Value>
                                <Value>ApiQuery</Value>
                                <Value>ApiPlan</Value>
                                <Value>SearchUsers</Value>
                                <Value>SearchGroups</Value>
                                <Value>SearchRoles</Value>
                                <Value>AddUserToGroup</Value>
                                <Value>ChangesList</Value>
                                <Value>ChangesRollback</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="AddUserToGroup" PackageId="ImtAssistGqlPck" ComponentId="AdministrationAddUserToGroupAction">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DocumentActionJournal" Type="Reference" ExportId="DocumentActionJournal">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="GroupTypeId" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="Group"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="RequestHandlers" Type="Reference[]" ExportId="RequestHandlers">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ApiCatalog" PackageId="ImtAssistGqlPck" ComponentId="AssistantApiCatalog">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="AllowedMutations" Type="Id[]" ExportId="AllowedMutations">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>GroupAdd</Value>
                                <Value>GroupUpdate</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="AllowedQueries" Type="Id[]" ExportId="AllowedQueries">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>UsersList</Value>
                                <Value>UserItem</Value>
                                <Value>GroupsList</Value>
                                <Value>GroupItem</Value>
                                <Value>RolesList</Value>
                                <Value>RoleItem</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ForbiddenCommands" Type="Id[]" ExportId="ForbiddenCommands">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ForbiddenFields" Type="Id[]" ExportId="ForbiddenFields">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="SchemaPaths" Type="String[]" ExportId="ApiSchemaPaths">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>:/AssistantApi</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ApiDescribe" PackageId="ImtAssistGqlPck" ComponentId="AssistantApiAction">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="ApiCatalog" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="ApiCatalog"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Kind" Type="Id" ExportId="">
