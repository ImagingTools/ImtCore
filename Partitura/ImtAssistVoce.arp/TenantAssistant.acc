        </Element>
        <Element Id="AssistantController" PackageId="ImtAssistGqlPck" ComponentId="AssistantController">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="AllowDemoPrincipal" Type="Boolean" ExportId="">
                        <Data IsEnabled="true" Value="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="AssistantLogicController" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="AssistantLogicController"/>
                    </AttributeInfo>
                    <AttributeInfo Id="CommandIds" Type="Id[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>AssistantGetStatus</Value>
                                <Value>AssistantStartConversation</Value>
                                <Value>AssistantSendMessage</Value>
                                <Value>AssistantConfirmPreview</Value>
                                <Value>AssistantRejectPreview</Value>
                                <Value>AssistantCancelRequest</Value>
