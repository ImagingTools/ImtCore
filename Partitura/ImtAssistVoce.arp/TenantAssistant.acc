                <AttributeInfoMap>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ChangesList" PackageId="ImtAssistGqlPck" ComponentId="AssistantDocumentAction">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DocumentActionJournal" Type="Reference" ExportId="DocumentActionJournal">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Collections" Type="Reference[]" ExportId="RollbackCollections">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Delegates" Type="Reference[]" ExportId="RollbackDelegates">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="EditPermissions" Type="Id[]" ExportId="RollbackEditPermissions">
