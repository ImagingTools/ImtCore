                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="RemovePermissions" Type="Id[]" ExportId="RollbackRemovePermissions">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="RequestHandlers" Type="Reference[]" ExportId="RequestHandlers">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ChangesRollback" PackageId="ImtAssistGqlPck" ComponentId="AssistantDocumentAction">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DocumentActionJournal" Type="Reference" ExportId="DocumentActionJournal">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Collections" Type="Reference[]" ExportId="RollbackCollections">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Delegates" Type="Reference[]" ExportId="RollbackDelegates">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="EditPermissions" Type="Id[]" ExportId="RollbackEditPermissions">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Kind" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="rollback"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="RemovePermissions" Type="Id[]" ExportId="RollbackRemovePermissions">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="RequestHandlers" Type="Reference[]" ExportId="RequestHandlers">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ConfigurationController" PackageId="ImtAssistGqlPck" ComponentId="AssistantConfigurationController">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="CommandIds" Type="Id[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>AssistantGetConfiguration</Value>
                                <Value>AssistantSetConfiguration</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ConfigurationStore" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="ConfigurationStore"/>
                    </AttributeInfo>
                    <AttributeInfo Id="EditPermission" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="/Administration/Assistant/Edit"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ViewPermission" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="/Administration/Assistant/View"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ConfigurationStore" PackageId="ImtAssistPck" ComponentId="AssistantConfigurationStore">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="AllowCustomEndpoints" Type="Boolean" ExportId="AllowCustomEndpoints">
                        <Data IsEnabled="true" Value="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="AllowedPresets" Type="Id[]" ExportId="AllowedPresets">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="CacheTimeToLive" Type="Integer" ExportId="">
                        <Data IsEnabled="true" Value="10"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ConfigurationCollection" Type="Reference" ExportId="ConfigurationCollection">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ConfigurationFactory" Type="Factory" ExportId="">
                        <Data IsEnabled="true" Value="AssistantConfiguration"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="SecretProtector" Type="Reference" ExportId="SecretProtector">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="KnowledgeBase" PackageId="ImtAssistPck" ComponentId="MarkdownKnowledgeBase">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DocumentPaths" Type="String[]" ExportId="KnowledgeDocuments">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>:/AssistantKnowledge/ImtCore</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="KnowledgeRead" PackageId="ImtAssistPck" ComponentId="AssistantKnowledgeAction">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="Kind" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="read"/>
                    </AttributeInfo>
                    <AttributeInfo Id="KnowledgeBase" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="KnowledgeBase"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="KnowledgeSearch" PackageId="ImtAssistPck" ComponentId="AssistantKnowledgeAction">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="Kind" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="search"/>
                    </AttributeInfo>
                    <AttributeInfo Id="KnowledgeBase" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="KnowledgeBase"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Provider" PackageId="ImtAssistPck" ComponentId="TenantAssistantProvider">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="AdditionalInstructions" Type="Text" ExportId="AdditionalInstructions">
                        <Data IsEnabled="true" Value="You are the assistant of the product. To solve a task: understand it with knowledge.search and knowledge.read (concepts, rules, meaning of the API); find the commands with api.listCommands and read them with api.describeCommand; read the current data with api.query; then propose changes as one plan with api.planChanges. Never invent IDs: find them first. Update commands replace the whole object: read it first and send all its values with the change. Prefer few steps; explain the plan in plain words. If a step fails, say what was applied. Ask back when the task is ambiguous."/>
                    </AttributeInfo>
                    <AttributeInfo Id="AllowServerCredentials" Type="Boolean" ExportId="AllowServerCredentials">
                        <Data IsEnabled="true" Value="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="ConfigurationStore" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="ConfigurationStore"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="RepresentationRegistry" PackageId="ImtAssistPck" ComponentId="UiRepresentationRegistry">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="RegisterStandardRepresentations" Type="Boolean" ExportId="">
                        <Data IsEnabled="true" Value="true"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="SearchGroups" PackageId="ImtAssistGqlPck" ComponentId="AdministrationSearchAction">
