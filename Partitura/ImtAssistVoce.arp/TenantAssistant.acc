    <EmbeddedRegistriesList/>
    <ExportedInterfaces>
        <Interface InterfaceId="imtassist::IAssistantActionRegistry" ComponentId="ActionRegistry"/>
        <Interface InterfaceId="imtassist::IAssistantConfigurationStore" ComponentId="ConfigurationStore"/>
        <Interface InterfaceId="imtassist::IAssistantLogicController" ComponentId="AssistantLogicController"/>
        <Interface InterfaceId="imtgql::IGqlRequestHandler" ComponentId="AssistantController"/>
    </ExportedInterfaces>
    <ExportedComponents>
        <Component ExportedId="ActionRegistry" ComponentId="ActionRegistry"/>
        <Component ExportedId="ApiCatalog" ComponentId="ApiCatalog"/>
        <Component ExportedId="AssistantController" ComponentId="AssistantController"/>
