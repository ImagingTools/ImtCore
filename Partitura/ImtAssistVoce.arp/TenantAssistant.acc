        <Component ExportedId="ConfigurationController" ComponentId="ConfigurationController"/>
        <Component ExportedId="ConfigurationStore" ComponentId="ConfigurationStore"/>
        <Component ExportedId="KnowledgeBase" ComponentId="KnowledgeBase"/>
    </ExportedComponents>
</Acf>
