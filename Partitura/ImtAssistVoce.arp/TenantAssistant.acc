                        <Data IsEnabled="true" Value="ConfigurationStore"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="AuditLog" PackageId="ImtAssistPck" ComponentId="AssistantAuditLog">
