                        <Data IsEnabled="true" Value="ActionRegistry"/>
                    </AttributeInfo>
                    <AttributeInfo Id="AuditLog" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="AuditLog"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Enabled" Type="Boolean" ExportId="Enabled">
                        <Data IsEnabled="true" Value="true"/>
                    </AttributeInfo>
                    <AttributeInfo Id="Log" Type="Reference" ExportId="Log">
                        <Data IsEnabled="false"/>
                    </AttributeInfo>
                    <AttributeInfo Id="MaxStepsPerTurn" Type="Integer" ExportId="MaxStepsPerTurn">
