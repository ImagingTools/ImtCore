<?xml version="1.0" encoding="UTF-8"?>
<Acf>
    <AcfHeader>
        <VersionInfos>
            <Version Id="0" Number="6637" Description="ACF"/>
            <Version Id="1" Number="2463" Description="ACF-Solutions"/>
            <Version Id="1023" Number="396033" Description="Qt Framework"/>
        </VersionInfos>
    </AcfHeader>
    <Description>Server settings of the AI assistant: enabling, provider, model, endpoint, API key</Description>
    <Keywords>Assistant AI Settings Provider</Keywords>
    <ElementsList>
        <Element Id="AdditionalInstructions" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value=""/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ApiKey" PackageId="ImtCryptPck" ComponentId="ProtectedTextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="SecretProtector" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="SecretProtector"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Assistant" PackageId="BasePck" ComponentId="ComposedParamsSet">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="Parameters" Type="Reference[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>AdditionalInstructions</Value>
                                <Value>ApiKey</Value>
                                <Value>AssistantEnabled</Value>
                                <Value>Endpoint</Value>
                                <Value>MaxOutputTokens</Value>
                                <Value>Model</Value>
                                <Value>Project</Value>
                                <Value>Provider</Value>
                                <Value>Region</Value>
                                <Value>Resource</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ParametersDescription" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>Instructions of the application appended to the rules of the assistant</Value>
                                <Value>API key or access token of the provider. Stored protected; leave empty to use the environment variable of the server</Value>
                                <Value>Without enabling, no request is sent to a model provider</Value>
                                <Value>URL of the API; empty uses the endpoint of the provider. Required for Aleph Alpha and other OpenAI-compatible servers</Value>
                                <Value>Maximum number of tokens the model may generate per answer</Value>
                                <Value>Model ID of the provider; for Azure OpenAI the deployment name</Value>
                                <Value>Google Cloud project (Vertex AI only)</Value>
                                <Value>Model provider used by the assistant</Value>
                                <Value>Region of the provider, e.g. eu-central-1 (Amazon Bedrock) or europe-west4 (Vertex AI)</Value>
                                <Value>Name of the Azure OpenAI resource (Azure OpenAI only)</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ParametersId" Type="Id[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>AdditionalInstructions</Value>
                                <Value>ApiKey</Value>
                                <Value>AssistantEnabled</Value>
                                <Value>Endpoint</Value>
                                <Value>MaxOutputTokens</Value>
                                <Value>Model</Value>
                                <Value>Project</Value>
                                <Value>Provider</Value>
                                <Value>Region</Value>
                                <Value>Resource</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="ParametersName" Type="Text[]" ExportId="">
                        <Data IsEnabled="true">
                            <Values>
                                <Value>Additional instructions</Value>
                                <Value>API key</Value>
                                <Value>Enable AI assistant</Value>
                                <Value>Endpoint</Value>
                                <Value>Maximum answer length (tokens)</Value>
                                <Value>Model</Value>
                                <Value>Project</Value>
                                <Value>Provider</Value>
                                <Value>Region</Value>
                                <Value>Resource</Value>
                            </Values>
                        </Data>
                    </AttributeInfo>
                    <AttributeInfo Id="TypeId" Type="Id" ExportId="">
                        <Data IsEnabled="true" Value="Default"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="AssistantEnabled" PackageId="BasePck" ComponentId="EnableableParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultEnabled" Type="Boolean" ExportId="">
                        <Data IsEnabled="true" Value="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Endpoint" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value=""/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="MaxOutputTokens" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value="1024"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Model" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value=""/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Project" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value=""/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Provider" PackageId="BasePck" ComponentId="SelectionParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="Constraints" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="ProviderList"/>
                    </AttributeInfo>
                    <AttributeInfo Id="DefaultIndex" Type="Integer" ExportId="">
                        <Data IsEnabled="true" Value="-1"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="ProviderList" PackageId="ImtAssistPck" ComponentId="AssistantProviderList">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap/>
            </Data>
        </Element>
        <Element Id="Region" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value=""/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Resource" PackageId="BasePck" ComponentId="TextParam">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="DefaultText" Type="Text" ExportId="">
                        <Data IsEnabled="true" Value=""/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="SecretProtector" PackageId="ImtCryptPck" ComponentId="SystemSecretProtector">
            <Data IsEnabled="true" Flags="0">
                <AttributeInfoMap>
                    <AttributeInfo Id="MachineScope" Type="Boolean" ExportId="">
                        <Data IsEnabled="true" Value="false"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
    </ElementsList>
    <EmbeddedRegistriesList/>
    <ExportedInterfaces>
        <Interface InterfaceId="iprm::IParamsSet" ComponentId="Assistant"/>
        <Interface InterfaceId="iser::ISerializable" ComponentId="Assistant"/>
        <Interface InterfaceId="istd::IChangeable" ComponentId="Assistant"/>
    </ExportedInterfaces>
    <ExportedComponents>
        <Component ExportedId="AdditionalInstructions" ComponentId="AdditionalInstructions"/>
        <Component ExportedId="ApiKey" ComponentId="ApiKey"/>
        <Component ExportedId="Assistant" ComponentId="Assistant"/>
        <Component ExportedId="AssistantEnabled" ComponentId="AssistantEnabled"/>
        <Component ExportedId="Endpoint" ComponentId="Endpoint"/>
        <Component ExportedId="MaxOutputTokens" ComponentId="MaxOutputTokens"/>
        <Component ExportedId="Model" ComponentId="Model"/>
        <Component ExportedId="Project" ComponentId="Project"/>
        <Component ExportedId="Provider" ComponentId="Provider"/>
        <Component ExportedId="Region" ComponentId="Region"/>
        <Component ExportedId="Resource" ComponentId="Resource"/>
    </ExportedComponents>
</Acf>
